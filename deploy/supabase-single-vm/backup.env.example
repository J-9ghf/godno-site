# Настройки копий. Рабочий файл: /etc/ikr-supabase/backup.env, владелец root, права 600 (install.sh создаёт его сам).
COMPOSE_DIR='/opt/ikr-supabase'
BACKUP_BUCKET='ikr-backup'
BACKUP_PREFIX='supabase-db'
BACKUP_KEEP_DAYS='14'
# Открытый ключ age (начинается с age1...). Закрытый ключ хранится у владельца, не на сервере.
AGE_RECIPIENT='age1ЗАПОЛНИТЕЛЬ'
# rclone берёт настройки только из переменных RCLONE_CONFIG_<ИМЯ>_* ниже, файл настроек rclone не нужен
RCLONE_CONFIG='/dev/null'
# Бакет копий (ключ доступа S3 может быть тем же, что для файлов)
RCLONE_CONFIG_BACKUP_TYPE='s3'
RCLONE_CONFIG_BACKUP_PROVIDER='Other'
RCLONE_CONFIG_BACKUP_ENDPOINT='https://s3.ru-1.storage.selcloud.ru'
RCLONE_CONFIG_BACKUP_REGION='ru-1'
RCLONE_CONFIG_BACKUP_ACCESS_KEY_ID='ЗАПОЛНИТЕЛЬ'
RCLONE_CONFIG_BACKUP_SECRET_ACCESS_KEY='ЗАПОЛНИТЕЛЬ'
# Копировать ли файлы кандидатов в бакет копий (1 — да)
FILES_BACKUP='1'
FILES_BUCKET='ikr-files'
RCLONE_CONFIG_FILES_TYPE='s3'
RCLONE_CONFIG_FILES_PROVIDER='Other'
RCLONE_CONFIG_FILES_ENDPOINT='https://s3.ru-1.storage.selcloud.ru'
RCLONE_CONFIG_FILES_REGION='ru-1'
RCLONE_CONFIG_FILES_ACCESS_KEY_ID='ЗАПОЛНИТЕЛЬ'
RCLONE_CONFIG_FILES_SECRET_ACCESS_KEY='ЗАПОЛНИТЕЛЬ'
