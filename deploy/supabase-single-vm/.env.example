# Настройки варианта 1 (Supabase на одной машине). Копия: /opt/ikr-supabase/.env, владелец root, права 600.
# Секреты (пароль базы, JWT_SECRET, ключи) не вписывайте вручную: их создаёт scripts/gen-keys.sh прямо на сервере.

# --- Адреса ---
DOMAIN='kabinet.ВАШ-ДОМЕН.ru'
PUBLIC_URL='https://kabinet.ВАШ-ДОМЕН.ru'
SITE_URL='https://kabinet.ВАШ-ДОМЕН.ru'
# Приложение ИКР на этой же машине (порт, на котором оно слушает 127.0.0.1)
APP_UPSTREAM='host.docker.internal:3000'

# --- Секреты (заполняет scripts/gen-keys.sh) ---
POSTGRES_PASSWORD='ЗАПОЛНИТЕЛЬ'
JWT_SECRET='ЗАПОЛНИТЕЛЬ'
ANON_KEY='ЗАПОЛНИТЕЛЬ'
SERVICE_ROLE_KEY='ЗАПОЛНИТЕЛЬ'
JWT_EXPIRY='1800'

# --- Файлы кандидатов: любой S3-совместимый бакет (приватный). Пример — Selectel, пул ru-1 ---
# Полный адрес со схемой https://
S3_ENDPOINT='https://s3.ru-1.storage.selcloud.ru'
S3_PROTOCOL='https'
S3_REGION='ru-1'
S3_BUCKET='ikr-files'
S3_FORCE_PATH_STYLE='true'
S3_ACCESS_KEY_ID='ЗАПОЛНИТЕЛЬ'
S3_SECRET_ACCESS_KEY='ЗАПОЛНИТЕЛЬ'
# 15 МБ — как в платформе
FILE_SIZE_LIMIT='15728640'
