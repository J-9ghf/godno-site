# Скопируйте в .env.local и заполните. Файлы .env* (кроме этого) не коммитятся.

# Адрес приложения без слеша в конце (ссылки в письмах).
APP_URL=http://localhost:3000

# Supabase. Все три переменные — только для сервера: в браузер не попадают
# (без префикса NEXT_PUBLIC_). При переезде на свой сервер меняются только они.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Почта: console — письма печатаются в лог сервера (разработка); smtp — реальная отправка.
EMAIL_PROVIDER=console
EMAIL_FROM="Институт кадровых решений <noreply@example.com>"
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=

# Автовыход после бездействия, минут (по ТЗ 30).
SESSION_IDLE_MINUTES=30
# Максимальная длительность сессии, часов.
SESSION_MAX_HOURS=12

# Только разработка и e2e: при EMAIL_PROVIDER=console письма дописываются в этот файл.
# EMAIL_OUTBOX_FILE=/tmp/ikr-outbox.jsonl

# Секрет для подписи служебных токенов форм: не меньше 32 случайных символов (openssl rand -base64 48).
APP_SECRET=

# Капча форм сайта: off (только разработка) или smartcaptcha (Яндекс SmartCaptcha, ключи в Yandex Cloud).
CAPTCHA_PROVIDER=off
SMARTCAPTCHA_CLIENT_KEY=
SMARTCAPTCHA_SERVER_KEY=

# Уведомления команде в Telegram (этап 6 расширит). Пусто — уведомления пишутся только в лог.
TELEGRAM_BOT_TOKEN=
TELEGRAM_TEAM_CHAT_ID=

# Форма резюме: test — пометка «тестовый режим» (пока нет текста согласия от юриста); live — рабочий режим.
RESUME_FORM_MODE=test
