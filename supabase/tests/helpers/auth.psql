-- Помощники тестов: действовать от имени пользователя так же, как это делает Supabase/PostgREST.
-- Подключается из тестов через \ir. Создаётся внутри транзакции теста и откатывается вместе с ней.
create extension if not exists pgtap;
create schema if not exists tests;
grant usage on schema tests to public;

-- p_session — id сессии из JWT (нужен админу: права есть только у подтверждённой кодом сессии).
create or replace function tests.act_as(p_uid uuid, p_session uuid default null)
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims',
    json_build_object('sub', p_uid, 'role', 'authenticated', 'session_id', p_session)::text, true);
  execute 'set local role authenticated';
end;
$$;

create or replace function tests.act_as_anon()
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', json_build_object('role', 'anon')::text, true);
  execute 'set local role anon';
end;
$$;

create or replace function tests.act_as_service()
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', json_build_object('role', 'service_role')::text, true);
  execute 'set local role service_role';
end;
$$;

-- Вернуться к владельцу базы (для подготовки данных внутри теста).
create or replace function tests.as_owner()
returns void
language plpgsql
as $$
begin
  execute 'reset role';
  perform set_config('request.jwt.claims', '', true);
end;
$$;

-- Подтвердить сессию админа (то, что делает сервер после проверки кода).
create or replace function tests.verify_session(p_uid uuid, p_session uuid)
returns void
language sql
as $$
  insert into public.verified_sessions (session_id, user_id) values (p_session, p_uid)
  on conflict (session_id) do nothing;
$$;

grant execute on all functions in schema tests to public;
