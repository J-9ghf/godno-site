---
/** Шапка секции в духе референса: тонкая линия, номер, метка, опционально — подпись справа. */
interface Props {
  num: string;
  label: string;
  aside?: string;
  class?: string;
}
const { num, label, aside, class: className } = Astro.props;
---

<p class:list={['shead', className]}>
  <span class="eyebrow shead__num">{num}</span>
  <span class="eyebrow">{label}</span>
  {aside && <span class="eyebrow shead__aside">{aside}</span>}
</p>
