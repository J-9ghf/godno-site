---
import Icon from './Icon.astro';
import type { Case } from '../data/content';

interface Props {
  item: Case;
  num: string;
  open?: boolean;
  compact?: boolean;
}

const { item, num, open = false, compact = false } = Astro.props;
const panelId = `case-${item.id}-panel`;
const btnId = `case-${item.id}-btn`;
const [lead, ...body] = item.body;
---

<article class:list={['case', { 'is-open': open, 'case--compact': compact }]} id={`case-${item.id}`} data-accordion>
  <h3 class="case__heading">
    <button
      class="case__trigger grid"
      id={btnId}
      type="button"
      aria-expanded={open ? 'true' : 'false'}
      aria-controls={panelId}
      data-accordion-trigger
    >
      <span class="case__num num">{num}</span>
      <span class="case__main">
        <span class="case__title">{item.title}</span>
        <span class="case__hint eyebrow" aria-hidden="true">
          <span class="case__hint-open">Читать кейс</span>
          <span class="case__hint-close">Свернуть</span>
        </span>
      </span>
      <span class="case__tags eyebrow">
        <span class="case__tag">{item.sphere}</span>
        <span class="case__tag case__tag--muted">{item.metaValue}</span>
      </span>
      <span class="case__toggle" aria-hidden="true">
        <Icon name="plus" />
      </span>
    </button>
  </h3>

  <div class="case__panel" id={panelId} role="region" aria-labelledby={btnId} data-accordion-panel>
    <div class="case__panel-inner">
      <div class="case__content grid">
        <div class="case__text">
          <p class:list={{ case__lead: body.length > 0 }}>{lead}</p>
          {body.map((p) => <p>{p}</p>)}
        </div>
        <aside class="case__aside">
          <dl class="case__meta">
            <div>
              <dt class="eyebrow">Сфера</dt>
              <dd>{item.sphere}</dd>
            </div>
            <div>
              <dt class="eyebrow">{item.metaLabel}</dt>
              <dd>{item.metaValue}</dd>
            </div>
          </dl>
          {
            item.figure && (
              <p class="case__figure">
                <span class="case__figure-value">{item.figure.value}</span>
                <span class="case__figure-caption eyebrow">{item.figure.caption}</span>
              </p>
            )
          }
        </aside>
      </div>
    </div>
  </div>
</article>

<style>
  .case {
    border-bottom: 1px solid var(--c-line-strong);
  }

  .case__heading {
    font: inherit;
  }

  .case__trigger {
    align-items: start;
    width: 100%;
    padding: clamp(2rem, 3.5vw, 3rem) 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
  }

  .case__num {
    grid-column: 1 / span 2;
    font-size: clamp(2.5rem, 1.6rem + 2.6vw, 4.5rem);
    font-weight: 700;
    line-height: 0.85;
    letter-spacing: -0.05em;
    color: var(--c-blue-muted);
    transition: color var(--t-base) var(--ease);
  }

  .case__main {
    grid-column: 3 / span 6;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .case__title {
    max-width: 20ch;
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
    text-wrap: balance;
    transition: color var(--t-base) var(--ease);
  }

  /* Подсказка появляется при hover */
  .case__hint {
    color: var(--c-blue);
    opacity: 0;
    transform: translateY(-4px);
    transition:
      opacity var(--t-base) var(--ease),
      transform var(--t-base) var(--ease);
  }

  .case__hint-close,
  .case.is-open .case__hint-open {
    display: none;
  }

  .case.is-open .case__hint-close {
    display: inline;
  }

  .case__tags {
    grid-column: 9 / span 3;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 0.5rem;
  }

  .case__tag--muted {
    color: var(--c-ink-3);
  }

  .case__toggle {
    grid-column: 12;
    justify-self: end;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--c-line-strong);
    border-radius: var(--r-md);
    color: var(--c-black);
    transition:
      background-color var(--t-base) var(--ease),
      border-color var(--t-base) var(--ease),
      color var(--t-base) var(--ease);
  }

  :global(.case__toggle svg) {
    width: 18px;
    height: 18px;
    transition: transform var(--t-base) var(--ease);
  }

  .case__trigger:hover .case__num,
  .case.is-open .case__num {
    color: var(--c-blue);
  }

  .case__trigger:hover .case__hint,
  .case.is-open .case__hint {
    opacity: 1;
    transform: none;
  }

  .case__trigger:hover .case__toggle,
  .case.is-open .case__toggle {
    border-color: var(--c-blue);
    background: var(--c-blue);
    color: var(--c-white);
  }

  .case.is-open :global(.case__toggle svg) {
    transform: rotate(45deg);
  }

  /* Компактный вариант — «Также находили» */
  .case--compact .case__trigger {
    padding-block: clamp(1.5rem, 2.5vw, 2rem);
  }

  .case--compact .case__num {
    font-size: clamp(1.75rem, 1.3rem + 1.2vw, 2.5rem);
  }

  .case--compact .case__title {
    max-width: 28ch;
    font-size: clamp(1.25rem, 1.05rem + 0.6vw, 1.625rem);
  }

  /* Раскрытие */
  .case__panel {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.55s var(--ease);
  }

  :global(.js) .case:not(.is-open) .case__panel {
    grid-template-rows: 0fr;
  }

  .case__panel-inner {
    min-height: 0;
    overflow: hidden;
  }

  :global(.js) .case:not(.is-open) .case__panel-inner {
    visibility: hidden;
    transition: visibility 0s 0.55s;
  }

  .case__content {
    row-gap: 2rem;
    padding-bottom: clamp(2.5rem, 4vw, 3.5rem);
  }

  .case__text {
    grid-column: 3 / span 6;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    max-width: 62ch;
    color: var(--c-ink-2);
  }

  .case__lead {
    font-size: var(--fs-lead);
    font-weight: 500;
    line-height: 1.55;
    letter-spacing: -0.01em;
    color: var(--c-black);
  }

  .case__aside {
    grid-column: 9 / -1;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .case__meta div {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-block: 0.875rem;
    border-top: 1px solid var(--c-line);
  }

  .case__meta dt {
    color: var(--c-ink-3);
  }

  .case__meta dd {
    font-size: var(--fs-small);
    font-weight: 600;
  }

  .case__meta dd::first-letter {
    text-transform: uppercase;
  }

  .case__figure {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--c-black);
  }

  .case__figure-value {
    font-size: clamp(2.75rem, 2rem + 2.4vw, 4.5rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.05em;
    color: var(--c-blue);
  }

  .case__figure-caption {
    max-width: 22ch;
    color: var(--c-ink-3);
  }

  @media (max-width: 1024px) {
    .case__main {
      grid-column: 3 / span 8;
    }

    .case__tags {
      grid-column: 3 / span 8;
      grid-row: 2;
      flex-direction: row;
      gap: 1.25rem;
      padding-top: 1.25rem;
    }

    .case__toggle {
      grid-column: 12;
      grid-row: 1;
    }

    .case__text,
    .case__aside {
      grid-column: 3 / -1;
    }

    .case__hint {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .case__trigger {
      grid-template-columns: minmax(0, 1fr) 44px;
      column-gap: 1rem;
      row-gap: 1rem;
    }

    .case__num {
      grid-column: 1;
      grid-row: 1;
    }

    .case__main {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .case__tags {
      grid-column: 1 / -1;
      grid-row: 3;
      flex-wrap: wrap;
      padding-top: 0;
    }

    .case__toggle {
      grid-column: 2;
      grid-row: 1;
      width: 44px;
      height: 44px;
    }

    .case__text,
    .case__aside {
      grid-column: 1 / -1;
    }

    .case__lead {
      font-size: 1.0625rem;
    }
  }
</style>
