# Образец настроек. Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.
# Секреты генерируйте, например: openssl rand -base64 48
NODE_ENV=development
BASE_URL=http://localhost:4321
# Роль приложения (без обхода RLS). Пароль задаётся при выполнении db/bootstrap.sql
DATABASE_URL=postgres://ikr_app:ПАРОЛЬ@127.0.0.1:54329/ikr
# Роль владельца — только для миграций
DATABASE_OWNER_URL=postgres://ikr_owner:ПАРОЛЬ@127.0.0.1:54329/ikr
BETTER_AUTH_SECRET=
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12
# true, только если приложение стоит за собственным обратным прокси, который выставляет X-Real-IP
TRUST_PROXY=false
# Письма: file (папка MAIL_DIR), memory (тесты), smtp (рабочий режим, сервис ещё не выбран)
MAIL_TRANSPORT=file
MAIL_DIR=.dev/mail
MAIL_FROM=ИКР <no-reply@localhost>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Файлы: local (папка вне публичного каталога) или s3 (Yandex Object Storage, закрытый бакет)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.data/files
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
MAX_UPLOAD_MB=15
