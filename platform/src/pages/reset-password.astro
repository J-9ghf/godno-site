---
import Base from '../layouts/Base.astro';
import AuthShell from '../components/AuthShell.astro';
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
---
<Base title="Новый пароль">
  <AuthShell>
    <h1>Новый пароль</h1>
    <form id="resetForm" novalidate style="display:grid;gap:14px">
      <div class="form-alert" hidden></div>
      <div class="field"><label for="rp-pass">Новый пароль</label><input class="input" id="rp-pass" name="newPassword" type="password" autocomplete="new-password" /><span class="hint">Не короче 10 символов</span><span class="err" data-err="newPassword"></span></div>
      <div class="field"><label for="rp-pass2">Ещё раз</label><input class="input" id="rp-pass2" name="password2" type="password" autocomplete="new-password" /><span class="err" data-err="password2"></span></div>
      <button class="btn btn-primary" type="submit">Сохранить пароль</button>
    </form>
  </AuthShell>
</Base>
<script>
  import { bindForm } from '../scripts/forms';
  const f = document.getElementById('resetForm') as HTMLFormElement;
  const pw = (n: string) => (f.elements.namedItem(n) as HTMLInputElement).value;
  const token = new URLSearchParams(location.search).get('token') ?? '';
  history.replaceState(null, '', '/reset-password');   // убираем токен из адресной строки
  bindForm(f, {
    url: '/api/auth/reset-password',
    collect: () => ({ newPassword: pw('newPassword'), token }),
    validate: (): Record<string, string> => {
      if (!token) return { newPassword: 'Ссылка неполная. Запросите восстановление ещё раз.' };
      if (pw('newPassword').length < 10) return { newPassword: 'Не короче 10 символов' };
      if (pw('newPassword') !== pw('password2')) return { password2: 'Пароли не совпадают' };
      return {};
    },
    onSuccess: () => location.assign('/login?reset=1'),
  });
</script>
