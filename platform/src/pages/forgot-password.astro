---
import Base from '../layouts/Base.astro';
import AuthShell from '../components/AuthShell.astro';
---
<Base title="Восстановление пароля">
  <AuthShell>
    <h1>Восстановление пароля</h1>
    <form id="forgotForm" novalidate style="display:grid;gap:14px">
      <div class="form-alert" hidden></div>
      <div class="field"><label for="fp-email">Почта</label><input class="input" id="fp-email" name="email" type="email" autocomplete="username" /><span class="err" data-err="email"></span></div>
      <button class="btn btn-primary" type="submit">Отправить ссылку</button>
    </form>
    <div class="notice info" id="fp-done" hidden>Если такая почта есть в системе, мы отправили на неё ссылку. Она действует 1 час.</div>
    <a class="small" href="/login">Вернуться ко входу</a>
  </AuthShell>
</Base>
<script>
  import { bindForm, val } from '../scripts/forms';
  const f = document.getElementById('forgotForm') as HTMLFormElement;
  bindForm(f, {
    url: '/api/auth/request-password-reset',
    collect: () => ({ email: val(f, 'email').toLowerCase() }),
    validate: (): Record<string, string> => (/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(val(f, 'email')) ? {} : { email: 'Проверьте почту' }),
    onSuccess: () => { f.hidden = true; (document.getElementById('fp-done') as HTMLElement).hidden = false; },
  });
</script>
