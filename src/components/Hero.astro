---
import Icon from './Icon.astro';
import { hero } from '../data/content';

// Светло-голубым выделяется вторая половина заголовка — текст не меняется
const splitAt = hero.title.indexOf('почему');
const titleA = hero.title.slice(0, splitAt);
const titleB = hero.title.slice(splitAt);

// Направления — формулировки из ответа FAQ «Вы только подбираете или что-то ещё?»
const directions = ['Подбор', 'Бизнес-аналитика', 'Управленческий консалтинг'];
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <!-- Видео — фон всего первого экрана, без рамок и контейнеров -->
  <video
    class="hero__video"
    autoplay
    muted
    loop
    playsinline
    disablepictureinpicture
    preload="auto"
    poster="/media/hero-poster.jpg"
    aria-hidden="true"
    tabindex="-1"
    data-hero-video
  >
    <source src="/media/hero.webm" type="video/webm" />
    <source src="/media/hero.mp4" type="video/mp4" />
  </video>

  <!-- Лёгкое равномерное затемнение — только для читаемости белого текста -->
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="container hero__content">
    <!-- Верхняя строка: идентификация слева, направления справа -->
    <div class="hero__top grid" data-reveal>
      <p class="hero__label eyebrow">
        <span class="hero__label-line" aria-hidden="true"></span>
        Кадровое и управленческое бюро
      </p>
      <ul class="hero__dirs eyebrow" aria-label="Направления работы">
        {directions.map((d) => <li>{d}</li>)}
      </ul>
    </div>

    <h1 class="hero__title" id="hero-title" data-reveal style="--d: 80">
      {titleA}<span class="hero__hl">{titleB}</span>
    </h1>

    <!-- Нижняя строка со смещением по сетке: номер · подзаголовок · CTA · scroll -->
    <div class="hero__bottom grid" data-reveal style="--d: 200">
      <p class="hero__num eyebrow num" aria-hidden="true"><span>01</span> / 09</p>

      <p class="hero__subtitle">{hero.subtitle}</p>

      <div class="hero__cta">
        <a class="btn" href="#contact">
          {hero.cta}
          <Icon name="arrow-up-right" class="btn__icon" />
        </a>
      </div>

      <a class="hero__scroll eyebrow" href="#about">
        Scroll
        <span class="hero__scroll-line" aria-hidden="true"></span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 600px;
    overflow: hidden;
    isolation: isolate;
    background: #6f7478; /* тон кадра до загрузки poster */
    color: var(--c-white);
  }

  .hero__video {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 50% 50%;
    pointer-events: none;
  }

  .hero__video::-webkit-media-controls,
  .hero__video::-webkit-media-controls-start-playback-button {
    display: none !important;
    -webkit-appearance: none;
  }

  /* Не «кинотрейлер»: 25–50 % затемнения, сильнее только в зоне текста (низ-лево) */
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(10 12 17 / 0.34) 0, rgb(10 12 17 / 0) 200px),
      linear-gradient(0deg, rgb(10 12 17 / 0.42) 0%, rgb(10 12 17 / 0) 45%),
      linear-gradient(90deg, rgb(10 12 17 / 0.4) 0%, rgb(10 12 17 / 0.2) 55%, rgb(10 12 17 / 0.1) 100%);
  }

  .hero__content {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding-top: calc(var(--header-h-hero) + env(safe-area-inset-top));
    padding-bottom: env(safe-area-inset-bottom);
  }

  /* Верхняя строка */
  .hero__top {
    align-items: center;
    padding-top: clamp(1.25rem, 3.5vh, 2.25rem);
  }

  .hero__label {
    grid-column: 1 / span 6;
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .hero__label-line {
    width: 40px;
    height: 1px;
    background: var(--c-white);
  }

  .hero__dirs {
    grid-column: 7 / -1;
    justify-self: end;
    display: flex;
    color: rgb(255 255 255 / 0.85);
  }

  .hero__dirs li {
    padding-inline: 1rem;
  }

  .hero__dirs li:last-child {
    padding-right: 0;
  }

  .hero__dirs li + li {
    border-left: 1px solid rgb(255 255 255 / 0.4);
  }

  /* H1 — главный визуальный элемент */
  .hero__title {
    max-width: 13.5ch;
    margin-top: auto;
    font-size: min(var(--fs-hero), 9.4vh);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .hero__hl {
    color: var(--c-blue-light-2);
  }

  /* Нижняя строка */
  .hero__bottom {
    align-items: end;
    row-gap: 1.25rem;
    margin-top: clamp(1.75rem, 4.5vh, 3.25rem);
    padding-block: 1.25rem clamp(1.5rem, 3.5vh, 2.5rem);
    border-top: 1px solid rgb(255 255 255 / 0.4);
  }

  .hero__num {
    grid-column: 1 / span 2;
    align-self: start;
    color: rgb(255 255 255 / 0.7);
  }

  .hero__num span {
    color: var(--c-white);
  }

  .hero__subtitle {
    grid-column: 3 / span 4;
    align-self: start;
    max-width: 24ch;
    font-size: var(--fs-lead);
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: -0.01em;
  }

  .hero__cta {
    grid-column: 7 / span 3;
  }

  .hero__scroll {
    grid-column: 10 / -1;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    text-decoration: none;
  }

  .hero__scroll-line {
    position: relative;
    width: 56px;
    height: 1px;
    overflow: hidden;
    background: rgb(255 255 255 / 0.35);
  }

  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--c-white);
    transform: translateX(-100%);
    animation: scroll-hint 2.6s var(--ease) infinite;
  }

  @keyframes scroll-hint {
    0% {
      transform: translateX(-100%);
    }
    60%,
    100% {
      transform: translateX(100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-line::after {
      animation: none;
      transform: none;
    }
  }

  @media (max-width: 1100px) {
    .hero__subtitle {
      grid-column: 3 / span 5;
    }

    .hero__cta {
      grid-column: 8 / span 5;
      justify-self: end;
    }

    .hero__scroll {
      display: none;
    }
  }

  /* Tablet: кадр сдвинут к кандидатке, текст — снизу */
  @media (max-width: 960px) {
    .hero__video {
      object-position: 64% 50%;
    }

    .hero__shade {
      background:
        linear-gradient(180deg, rgb(10 12 17 / 0.36) 0, rgb(10 12 17 / 0) 180px),
        linear-gradient(0deg, rgb(10 12 17 / 0.62) 0%, rgb(10 12 17 / 0.3) 55%, rgb(10 12 17 / 0.12) 100%);
    }

    .hero__dirs {
      display: none;
    }

    .hero__num {
      display: none;
    }

    .hero__subtitle {
      grid-column: 1 / span 7;
    }
  }

  /* Mobile */
  @media (max-width: 640px) {
    .hero {
      min-height: 560px;
    }

    .hero__video {
      object-position: 60% 50%;
    }

    .hero__title {
      max-width: none;
      font-size: clamp(2.25rem, 1.2rem + 5.2vw, 2.875rem);
      line-height: 1.02;
    }

    .hero__bottom {
      margin-top: 1.5rem;
      padding-block: 1.25rem calc(1.5rem + env(safe-area-inset-bottom));
    }

    .hero__subtitle,
    .hero__cta {
      grid-column: 1 / -1;
      justify-self: stretch;
    }

    .hero__subtitle {
      font-size: 1.0625rem;
    }

    .hero__cta .btn {
      width: 100%;
    }
  }
</style>
