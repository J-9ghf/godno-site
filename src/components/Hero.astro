---
import Icon from './Icon.astro';
import { hero } from '../data/content';

// Синим выделяется вторая половина заголовка — текст не меняется
const splitAt = hero.title.indexOf('почему');
const titleA = hero.title.slice(0, splitAt);
const titleB = hero.title.slice(splitAt);

// Направления — формулировки из ответа FAQ «Вы только подбираете или что-то ещё?»
const directions = ['Подбор', 'Бизнес-аналитика', 'Управленческий консалтинг'];
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__top" data-reveal>
      <p class="tag tag--on-soft tag--dot">Кадровое и управленческое бюро</p>
      <ul class="hero__dirs" aria-label="Направления работы">
        {directions.map((d) => <li>{d}</li>)}
      </ul>
    </div>

    <h1 class="hero__title display" id="hero-title" data-reveal style="--d: 80">
      {titleA}<span class="hl">{titleB}</span>
    </h1>

    <div class="hero__text">
      <p class="hero__subtitle lead" data-reveal style="--d: 160">{hero.subtitle}</p>

      <div class="hero__actions" data-reveal style="--d: 240">
        <a class="btn" href="#contact">
          {hero.cta}
          <Icon name="arrow-up-right" class="btn__icon" />
        </a>
        <a class="link-arrow hero__more" href="#process">
          Как мы работаем
          <Icon name="arrow-down" class="hero__more-icon" />
        </a>
      </div>
    </div>

    <figure class="hero__media" data-reveal style="--d: 200">
      <video
        class="hero__video"
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster="/media/hero-poster.jpg"
        aria-label="Разговор с кандидатом в переговорной"
        data-hero-video
      >
        <source src="/media/hero.webm" type="video/webm" />
        <source src="/media/hero.mp4" type="video/mp4" />
      </video>

      <figcaption class="hero__chip">
        <span class="hero__chip-num num">01</span>
        Разговор-диагностика
      </figcaption>

      <button class="hero__toggle" type="button" aria-pressed="false" data-video-toggle>
        <span class="visually-hidden" data-video-label>Остановить видео</span>
        <Icon name="pause" class="hero__toggle-pause" />
        <Icon name="play" class="hero__toggle-play" />
      </button>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(1.75rem, 3.5vh, 2.75rem) clamp(2.5rem, 5vh, 4rem);
    background: var(--c-soft);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-areas:
      'top   top   top   top   top   top   top   top   top   top   top   top'
      'title title title title title title title title title title title title'
      'text  text  text  text  media media media media media media media media';
    column-gap: var(--gutter);
  }

  .hero__top {
    grid-area: top;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  /* Направления — тонкие вертикальные разделители, как в референсе */
  .hero__dirs {
    display: flex;
  }

  .hero__dirs li {
    padding-inline: 1.25rem;
    font-size: var(--fs-meta);
    font-weight: 700;
    color: var(--c-ink-2);
  }

  .hero__dirs li + li {
    border-left: 1px solid var(--c-line-strong);
  }

  .hero__dirs li:last-child {
    padding-right: 0;
  }

  .hero__title {
    grid-area: title;
    max-width: 24ch;
    margin-block: clamp(1.5rem, 4vh, 2.75rem) clamp(1.75rem, 4.5vh, 3rem);
    font-size: clamp(2.25rem, 1.1rem + 3.6vw, 4.5rem);
  }

  .hero__text {
    grid-area: text;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
    padding-top: 0.25rem;
    border-top: 1px solid var(--c-line-strong);
  }

  .hero__subtitle {
    max-width: 22ch;
    padding-top: 1.5rem;
    color: var(--c-ink-2);
  }

  .hero__actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .hero__more {
    font-size: var(--fs-small);
  }

  :global(.hero__more-icon) {
    width: 16px;
    height: 16px;
  }

  /* Видео — внутри композиции, не фоном */
  .hero__media {
    grid-area: media;
    position: relative;
    aspect-ratio: 16 / 8.6;
    overflow: hidden;
    border-radius: var(--r-xl);
    background: #d9dde2;
    isolation: isolate;
  }

  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* в кадре: кандидатка — центр, собеседник — справа */
    object-position: 60% 50%;
  }

  .hero__chip {
    position: absolute;
    left: 1.25rem;
    bottom: 1.25rem;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.5rem 1rem 0.5rem 0.5rem;
    border-radius: 999px;
    background: var(--c-white);
    font-size: var(--fs-small);
    font-weight: 700;
    box-shadow: 0 8px 24px -12px rgb(10 12 17 / 0.3);
  }

  .hero__chip-num {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--c-blue);
    color: var(--c-white);
    font-size: 0.6875rem;
  }

  .hero__toggle {
    position: absolute;
    right: 1.25rem;
    bottom: 1.25rem;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.9);
    color: var(--c-black);
    cursor: pointer;
    transition: background-color var(--t-fast) var(--ease);
  }

  .hero__toggle:hover {
    background: var(--c-white);
  }

  :global(.hero__toggle svg) {
    width: 16px;
    height: 16px;
  }

  :global(.hero__toggle-play),
  .hero__toggle[aria-pressed='true'] :global(.hero__toggle-pause) {
    display: none;
  }

  .hero__toggle[aria-pressed='true'] :global(.hero__toggle-play) {
    display: block;
  }

  @media (max-width: 1100px) {
    .hero__grid {
      grid-template-areas:
        'top   top   top   top   top   top   top   top   top   top   top   top'
        'title title title title title title title title title title title title'
        'text  text  text  text  text  media media media media media media media';
    }
  }

  /* Tablet: видео на всю ширину под текстом */
  @media (max-width: 860px) {
    .hero__grid {
      grid-template-areas:
        'top'
        'title'
        'text'
        'media';
      grid-template-columns: 1fr;
    }

    .hero__dirs {
      display: none;
    }

    .hero__text {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-end;
      margin-bottom: 2rem;
      border-top: 0;
      padding-top: 0;
    }

    .hero__subtitle {
      padding-top: 0;
      max-width: 26ch;
    }

    .hero__media {
      aspect-ratio: 16 / 10;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-bottom: 2rem;
    }

    .hero__title {
      margin-block: 1.5rem 1.25rem;
      font-size: clamp(2.125rem, 1.2rem + 4.6vw, 2.75rem);
      line-height: 1.06;
    }

    .hero__text {
      flex-direction: column;
      align-items: stretch;
      gap: 1.75rem;
    }

    .hero__actions {
      align-items: stretch;
    }

    .hero__actions .btn {
      width: 100%;
    }

    .hero__more {
      align-self: flex-start;
    }

    .hero__media {
      aspect-ratio: 4 / 5;
      border-radius: var(--r-lg);
      margin-inline: calc(var(--pad) * -0.5);
    }

    /* Узкий кадр: держим кандидатку и собеседника в центре */
    .hero__video {
      object-position: 72% 50%;
    }

    .hero__chip {
      left: 1rem;
      bottom: 1rem;
    }

    .hero__toggle {
      right: 1rem;
      bottom: 1rem;
    }
  }
</style>
