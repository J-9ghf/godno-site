---
import Icon from './Icon.astro';
import { hero } from '../data/content';

// Светло-голубым выделяется вторая половина заголовка — текст не меняется
const splitAt = hero.title.indexOf('почему');
const titleA = hero.title.slice(0, splitAt);
const titleB = hero.title.slice(splitAt);

// Направления — формулировки из ответа FAQ «Вы только подбираете или что-то ещё?»
const directions = ['Подбор', 'Бизнес-аналитика', 'Управленческий консалтинг'];
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <!-- Видео — фон всего первого экрана, без рамок и контейнеров -->
  <video
    class="hero__video"
    autoplay
    muted
    loop
    playsinline
    disablepictureinpicture
    preload="auto"
    poster="/media/hero-poster.jpg"
    aria-hidden="true"
    tabindex="-1"
    data-hero-video
  >
    <source src="/media/hero.webm" type="video/webm" />
    <source src="/media/hero.mp4" type="video/mp4" />
  </video>

  <!-- Лёгкое равномерное затемнение — только для читаемости белого текста -->
  <div class="hero__shade" aria-hidden="true"></div>

  <div class="container hero__content">
    <!-- Институциональный маркер: узел + метка -->
    <p class="hero__label eyebrow" data-reveal>
      <span class="node" aria-hidden="true"></span>
      Кадровое и управленческое бюро
    </p>

    <!-- Вертикальная типографика по правому краю -->
    <ul class="hero__dirs eyebrow" aria-label="Направления работы" data-reveal style="--d: 300">
      {directions.map((d) => <li>{d}</li>)}
    </ul>

    <h1 class="hero__title" id="hero-title" data-reveal style="--d: 80">
      {titleA}<span class="hero__hl">{titleB}</span>
    </h1>

    <!-- Нижняя строка: подзаголовок · CTA · индекс -->
    <div class="hero__bottom grid" data-reveal style="--d: 200">

      <p class="hero__subtitle">{hero.subtitle}</p>

      <div class="hero__cta">
        <a class="btn" href="#contact">
          {hero.cta}
          <Icon name="arrow-up-right" class="btn__icon" />
        </a>
      </div>

      <a class="hero__scroll eyebrow" href="#about">
        <span class="num"><span class="hero__scroll-num">01</span> / 10</span>
        <span class="hero__scroll-line" aria-hidden="true"></span>
        Далее
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 600px;
    overflow: hidden;
    isolation: isolate;
    background: #5d6873; /* тон кадра до загрузки poster */
    color: var(--c-white);
  }

  .hero__video {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 50% 50%;
    pointer-events: none;
  }

  .hero__video::-webkit-media-controls,
  .hero__video::-webkit-media-controls-start-playback-button {
    display: none !important;
    -webkit-appearance: none;
  }

  /* Лёгкая navy-тонировка в цвет бренда — сильнее только у текста (низ, лево) */
  .hero__shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgb(16 36 58 / 0.4) 0, rgb(16 36 58 / 0) 220px),
      linear-gradient(0deg, rgb(16 36 58 / 0.55) 0%, rgb(16 36 58 / 0) 50%),
      linear-gradient(90deg, rgb(16 36 58 / 0.42) 0%, rgb(16 36 58 / 0.14) 60%, rgb(16 36 58 / 0.06) 100%);
  }

  .hero__content {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    padding-top: calc(var(--header-h-hero) + env(safe-area-inset-top));
    padding-bottom: env(safe-area-inset-bottom);
  }

  .hero__label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: clamp(1.5rem, 5vh, 3.5rem);
  }

  .hero__label :global(.node) {
    background: var(--c-accent-bright);
  }

  /* Направления — вертикальная строка у правого края */
  .hero__dirs {
    position: absolute;
    right: var(--pad);
    top: calc(var(--header-h-hero) + env(safe-area-inset-top) + clamp(1.5rem, 5vh, 3.5rem));
    display: flex;
    gap: 1.5rem;
    white-space: nowrap;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    color: rgb(255 255 255 / 0.8);
  }

  @media (max-height: 780px) {
    .hero__dirs {
      display: none;
    }
  }

  .hero__dirs li + li::before {
    content: '·';
    margin-bottom: 1.5rem;
    color: var(--c-accent-bright);
  }

  /* H1 — главный визуальный элемент */
  .hero__title {
    max-width: 13.5ch;
    margin-top: auto;
    font-size: min(var(--fs-hero), 9.4vh);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .hero__hl {
    color: var(--c-accent-bright);
  }

  .hero__bottom {
    align-items: end;
    row-gap: 1.25rem;
    margin-top: clamp(1.5rem, 4vh, 2.75rem);
    padding-bottom: clamp(1.75rem, 4vh, 2.75rem);
  }

  .hero__subtitle {
    grid-column: 1 / span 4;
    max-width: 24ch;
    font-size: var(--fs-lead);
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: rgb(255 255 255 / 0.92);
  }

  .hero__cta {
    grid-column: 5 / span 4;
  }

  .hero__scroll {
    grid-column: 10 / -1;
    justify-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    color: rgb(255 255 255 / 0.75);
    text-decoration: none;
  }

  .hero__scroll-num {
    color: var(--c-accent-bright);
  }

  .hero__scroll-line {
    position: relative;
    width: 40px;
    height: 2px;
    overflow: hidden;
    background: rgb(255 255 255 / 0.25);
  }

  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--c-accent-bright);
    transform: translateX(-100%);
    animation: scroll-hint 2.6s var(--ease) infinite;
  }

  @keyframes scroll-hint {
    0% {
      transform: translateX(-100%);
    }
    60%,
    100% {
      transform: translateX(100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-line::after {
      animation: none;
      transform: none;
    }
  }

  @media (max-width: 1100px) {
    .hero__subtitle {
      grid-column: 1 / span 6;
    }

    .hero__cta {
      grid-column: 7 / span 6;
      justify-self: end;
    }

    .hero__scroll {
      display: none;
    }

    .hero__dirs {
      display: none;
    }
  }

  /* Tablet: кадр сдвинут к кандидатке, текст — снизу */
  @media (max-width: 960px) {
    .hero__video {
      object-position: 64% 50%;
    }

    .hero__shade {
      background:
        linear-gradient(180deg, rgb(16 36 58 / 0.42) 0, rgb(16 36 58 / 0) 180px),
        linear-gradient(0deg, rgb(16 36 58 / 0.72) 0%, rgb(16 36 58 / 0.34) 55%, rgb(16 36 58 / 0.14) 100%);
    }
  }

  /* Mobile */
  @media (max-width: 640px) {
    .hero {
      min-height: 560px;
    }

    .hero__video {
      object-position: 60% 50%;
    }

    .hero__title {
      max-width: none;
      font-size: clamp(2.25rem, 1.2rem + 5.2vw, 2.875rem);
      line-height: 1.02;
    }

    .hero__bottom {
      margin-top: 1.25rem;
      padding-bottom: calc(1.5rem + env(safe-area-inset-bottom));
    }

    .hero__subtitle,
    .hero__cta {
      grid-column: 1 / -1;
      justify-self: stretch;
    }

    .hero__subtitle {
      font-size: 1.0625rem;
    }

    .hero__cta .btn {
      width: 100%;
    }
  }

  /* Самые маленькие телефоны (320–360 px, низкие экраны) */
  @media (max-width: 360px), (max-width: 640px) and (max-height: 600px) {
    .hero__label {
      padding-top: 0.75rem;
    }

    .hero__title {
      font-size: 1.875rem;
    }

    .hero__bottom {
      margin-top: 1rem;
    }

    .hero__subtitle {
      font-size: 0.9375rem;
    }
  }
</style>
