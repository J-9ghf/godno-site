---
import Icon from './Icon.astro';
import type { Case } from '../data/content';

interface Props {
  item: Case;
  num: string;
  open?: boolean;
  compact?: boolean;
}

const { item, num, open = false, compact = false } = Astro.props;
const panelId = `case-${item.id}-panel`;
const btnId = `case-${item.id}-btn`;
const [lead, ...body] = item.body;
---

<article class:list={['case', { 'is-open': open, 'case--compact': compact }]} id={`case-${item.id}`} data-accordion>
  <h3 class="case__heading">
    <button
      class="case__trigger"
      id={btnId}
      type="button"
      aria-expanded={open ? 'true' : 'false'}
      aria-controls={panelId}
      data-accordion-trigger
    >
      <span class="case__num num">{num}</span>
      <span class="case__title">{item.title}</span>
      <span class="case__meta">
        <span class="case__meta-item">
          <span class="case__meta-label">Сфера</span>
          <span class="case__meta-value">{item.sphere}</span>
        </span>
        <span class="case__meta-item">
          <span class="case__meta-label">{item.metaLabel}</span>
          <span class="case__meta-value">{item.metaValue}</span>
        </span>
      </span>
      <span class="case__toggle" aria-hidden="true">
        <Icon name="plus" />
      </span>
    </button>
  </h3>

  <div class="case__panel" id={panelId} role="region" aria-labelledby={btnId} data-accordion-panel>
    <div class="case__panel-inner">
      <div class="case__content">
        <div class="case__aside">
          {
            item.figure && (
              <p class="case__figure">
                <span class="case__figure-value">{item.figure.value}</span>
                <span class="case__figure-caption">{item.figure.caption}</span>
              </p>
            )
          }
        </div>
        <div class="case__text">
          <p class:list={{ case__lead: body.length > 0 }}>{lead}</p>
          {body.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </div>
  </div>
</article>

<style>
  .case {
    border-top: 1px solid var(--c-line);
  }

  .case__heading {
    font: inherit;
  }

  .case__trigger {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) minmax(0, 20rem) 44px;
    align-items: start;
    gap: var(--gutter);
    width: 100%;
    padding: clamp(1.5rem, 2.4vw, 2.25rem) 0;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
  }

  .case__num {
    padding-top: 0.35rem;
    font-size: var(--fs-small);
    font-weight: 800;
    color: var(--c-blue);
  }

  .case__title {
    max-width: 24ch;
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: var(--tr-title);
    text-wrap: balance;
    transition: color var(--t-base) var(--ease);
  }

  .case--compact .case__title {
    font-size: var(--fs-h4);
    max-width: none;
  }

  .case__meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gutter);
    padding-top: 0.3rem;
  }

  .case__meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .case__meta-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--c-ink-3);
  }

  .case__meta-value {
    font-size: var(--fs-small);
    font-weight: 600;
    line-height: 1.35;
  }

  .case__meta-value::first-letter {
    text-transform: uppercase;
  }

  .case__toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r-md);
    background: var(--c-blue-light);
    color: var(--c-blue);
    transition:
      background-color var(--t-base) var(--ease),
      color var(--t-base) var(--ease);
  }

  :global(.case__toggle svg) {
    width: 18px;
    height: 18px;
    transition: transform var(--t-base) var(--ease);
  }

  .case__trigger:hover .case__title {
    color: var(--c-blue);
  }

  .case__trigger:hover .case__toggle,
  .case.is-open .case__toggle {
    background: var(--c-blue);
    color: var(--c-white);
  }

  .case.is-open :global(.case__toggle svg) {
    transform: rotate(45deg);
  }

  /* Раскрытие через grid-rows: 0fr → 1fr */
  .case__panel {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.55s var(--ease);
  }

  :global(.js) .case:not(.is-open) .case__panel {
    grid-template-rows: 0fr;
  }

  .case__panel-inner {
    min-height: 0;
    overflow: hidden;
  }

  :global(.js) .case:not(.is-open) .case__panel-inner {
    visibility: hidden;
    transition: visibility 0s 0.55s;
  }

  .case__content {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) minmax(0, 20rem) 44px;
    gap: var(--gutter);
    padding-bottom: clamp(2rem, 3.5vw, 3rem);
  }

  .case__aside {
    grid-column: 3;
    grid-row: 1;
  }

  .case__text {
    grid-column: 2;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    max-width: 62ch;
    color: var(--c-ink-2);
  }

  .case__lead {
    font-size: var(--fs-lead);
    font-weight: 500;
    line-height: 1.55;
    letter-spacing: -0.01em;
    color: var(--c-black);
  }

  .case__figure {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: 1.5rem;
    border-radius: var(--r-lg);
    background: var(--c-blue-light);
  }

  .case__figure-value {
    font-size: clamp(2.25rem, 1.8rem + 1.4vw, 3.25rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--c-blue);
  }

  .case__figure-caption {
    font-size: var(--fs-small);
    font-weight: 600;
    line-height: 1.4;
    color: var(--c-ink-2);
  }

  @media (max-width: 1100px) {
    .case__trigger,
    .case__content {
      grid-template-columns: 3.5rem minmax(0, 1fr) 44px;
    }

    .case__meta {
      grid-column: 2;
      grid-row: 2;
      max-width: 26rem;
    }

    .case__toggle {
      grid-column: 3;
      grid-row: 1;
    }

    .case__aside {
      grid-column: 2;
      grid-row: 2;
      max-width: 22rem;
    }

    .case__text {
      grid-column: 2;
      grid-row: 1;
    }
  }

  @media (max-width: 640px) {
    .case__trigger,
    .case__content {
      grid-template-columns: minmax(0, 1fr) 40px;
      column-gap: 1rem;
      row-gap: 0.875rem;
    }

    .case__num {
      grid-column: 1;
      grid-row: 1;
      padding-top: 0;
    }

    .case__title {
      grid-column: 1;
      grid-row: 2;
    }

    .case__meta {
      grid-column: 1 / -1;
      grid-row: 3;
    }

    .case__toggle {
      grid-column: 2;
      grid-row: 1 / span 2;
      width: 40px;
      height: 40px;
    }

    .case__text,
    .case__aside {
      grid-column: 1 / -1;
    }

    .case__aside {
      grid-row: 2;
      max-width: none;
    }

    .case__lead {
      font-size: 1.0625rem;
    }
  }
</style>
