---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav } from '../data/content';

interface Props {
  /** '' на главной, '/' на внутренних страницах — чтобы якоря вели на главную */
  base?: string;
}
const { base = '' } = Astro.props;
---

<header class="header" data-header>
  <div class="container header__inner">
    <a class="header__brand" href={base || '#top'} aria-label="Институт кадровых решений — на главную">
      <Logo />
      <span class="header__divider" aria-hidden="true"></span>
      <span class="header__descr">Подбор ключевых сотрудников<br />и управленческий консалтинг</span>
    </a>

    <nav class="header__nav" aria-label="Основная навигация">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={`${base}${item.href}`} data-nav-link>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="btn header__cta" href={`${base}#contact`}>
      Обсудить задачу
      <Icon name="arrow-up-right" class="btn__icon" />
    </a>

    <button class="header__burger" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span class="visually-hidden" data-menu-label>Открыть меню</span>
      <span class="header__burger-line header__burger-line--top"></span>
      <span class="header__burger-line header__burger-line--bottom"></span>
    </button>
  </div>

  <div class="menu" id="mobile-menu" data-menu hidden>
    <nav class="container menu__inner" aria-label="Мобильная навигация">
      <ol class="menu__list">
        {
          nav.map((item, i) => (
            <li>
              <a href={`${base}${item.href}`} data-menu-link>
                <span class="menu__num num">{String(i + 1).padStart(2, '0')}</span>
                <span class="menu__text">{item.label}</span>
                <Icon name="arrow-right" class="menu__arrow" />
              </a>
            </li>
          ))
        }
      </ol>
      <a class="btn menu__cta" href={`${base}#contact`} data-menu-link>
        Обсудить задачу
        <Icon name="arrow-up-right" class="btn__icon" />
      </a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: rgb(255 255 255 / 0.96);
    border-bottom: 1px solid var(--c-line);
  }

  @supports (backdrop-filter: blur(1px)) {
    .header {
      background: rgb(255 255 255 / 0.85);
      backdrop-filter: saturate(1.4) blur(14px);
    }

    /* backdrop-filter создаёт containing block для fixed-меню — снимаем, пока меню открыто */
    .header.is-open {
      background: var(--c-white);
      backdrop-filter: none;
    }
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 100%;
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: 1.125rem;
    flex: none;
    text-decoration: none;
  }

  .header__divider {
    width: 1px;
    height: 32px;
    background: var(--c-line-strong);
  }

  .header__descr {
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.3;
    color: var(--c-ink-3);
  }

  .header__nav {
    margin-left: auto;
  }

  .header__nav ul {
    display: flex;
    gap: 0.25rem;
  }

  .header__nav a {
    display: block;
    padding: 0.5rem 0.75rem;
    border-radius: var(--r-sm);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--c-ink-2);
    text-decoration: none;
    transition:
      color var(--t-fast) var(--ease),
      background-color var(--t-fast) var(--ease);
  }

  .header__nav a:hover {
    color: var(--c-black);
    background: var(--c-soft);
  }

  .header__nav a.is-active {
    color: var(--c-blue);
  }

  .header__cta {
    min-height: 44px;
    padding-inline: 1.125rem;
    font-size: 0.9375rem;
    border-radius: var(--r-sm);
  }

  .header__burger {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    margin-left: auto;
    margin-right: -10px;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .header__burger-line {
    position: absolute;
    left: 11px;
    right: 11px;
    height: 2px;
    border-radius: 2px;
    background: var(--c-black);
    transition: transform var(--t-base) var(--ease);
  }

  .header__burger-line--top {
    top: 17px;
  }

  .header__burger-line--bottom {
    top: 25px;
  }

  .is-open .header__burger-line--top {
    transform: translateY(4px) rotate(45deg);
  }

  .is-open .header__burger-line--bottom {
    transform: translateY(-4px) rotate(-45deg);
  }

  .menu {
    position: fixed;
    inset: var(--header-h) 0 0;
    background: var(--c-white);
    overflow-y: auto;
    animation: fade-in var(--t-base) var(--ease);
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  .menu__inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100%;
    padding-block: 0.5rem 1.5rem;
  }

  .menu__list li {
    border-bottom: 1px solid var(--c-line);
  }

  .menu__list a {
    display: grid;
    grid-template-columns: 2.25rem 1fr auto;
    align-items: center;
    padding-block: 1.1rem;
    text-decoration: none;
  }

  .menu__num {
    font-size: var(--fs-meta);
    font-weight: 700;
    color: var(--c-blue);
  }

  .menu__text {
    font-size: 1.625rem;
    font-weight: 700;
    letter-spacing: var(--tr-title);
  }

  :global(.menu__arrow) {
    width: 20px;
    height: 20px;
    color: var(--c-ink-3);
  }

  .menu__cta {
    width: 100%;
    margin-top: 2rem;
  }

  @media (max-width: 1240px) {
    .header__descr,
    .header__divider {
      display: none;
    }
  }

  @media (max-width: 1060px) {
    .header__nav,
    .header__cta {
      display: none;
    }

    .header__burger {
      display: block;
    }

    .header__descr,
    .header__divider {
      display: block;
    }
  }

  @media (max-width: 560px) {
    .header__descr,
    .header__divider {
      display: none;
    }
  }

  @media (min-width: 1061px) {
    .menu {
      display: none;
    }
  }
</style>
