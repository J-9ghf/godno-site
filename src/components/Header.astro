---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { nav } from '../data/content';

interface Props {
  /** '' на главной, '/' на внутренних страницах — чтобы якоря вели на главную */
  base?: string;
  /** true — header лежит поверх hero-видео (главная) */
  overlay?: boolean;
}
const { base = '', overlay = false } = Astro.props;
---

<header class:list={['header', { 'header--overlay': overlay, 'is-solid': !overlay }]} data-header>
  <div class="container header__inner">
    <a class="header__brand" href={base || '#top'} aria-label="Институт кадровых решений — на главную">
      <Logo class="header__logo" />
    </a>

    <nav class="header__nav" aria-label="Основная навигация">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={`${base}${item.href}`} data-nav-link>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="btn header__cta" href={`${base}#contact`}>
      Обсудить задачу
      <Icon name="arrow-up-right" class="btn__icon" />
    </a>

    <button class="header__burger" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
      <span class="visually-hidden" data-menu-label>Открыть меню</span>
      <span class="header__burger-line header__burger-line--top"></span>
      <span class="header__burger-line header__burger-line--bottom"></span>
    </button>
  </div>

  <div class="menu" id="mobile-menu" data-menu hidden>
    <nav class="container menu__inner" aria-label="Мобильная навигация">
      <ol class="menu__list">
        {
          nav.map((item, i) => (
            <li>
              <a href={`${base}${item.href}`} data-menu-link>
                <span class="menu__num num">{String(i + 1).padStart(2, '0')}</span>
                <span class="menu__text">{item.label}</span>
                <Icon name="arrow-right" class="menu__arrow" />
              </a>
            </li>
          ))
        }
      </ol>
      <a class="btn menu__cta" href={`${base}#contact`} data-menu-link>
        Обсудить задачу
        <Icon name="arrow-up-right" class="btn__icon" />
      </a>
    </nav>
  </div>
</header>

<style>
  .header {
    --h: var(--header-h);
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: calc(var(--h) + env(safe-area-inset-top));
    padding-top: env(safe-area-inset-top);
    transition:
      height var(--t-base) var(--ease),
      background-color var(--t-base) var(--ease),
      box-shadow var(--t-base) var(--ease);
  }

  /* Поверх видео: без панели, чуть выше */
  .header--overlay {
    --h: var(--header-h-hero);
  }

  .header.is-solid,
  .header.is-open {
    --h: var(--header-h);
    background: var(--c-white);
    box-shadow: 0 1px 0 var(--c-line);
  }

  .header__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 100%;
  }

  .header__brand {
    display: block;
    flex: none;
    /* clear space вокруг логотипа */
    padding-block: 6px;
    text-decoration: none;
  }

  .header :global(.header__logo) {
    --logo-h: var(--logo-hero);
    transition: height var(--t-base) var(--ease);
  }

  .header.is-solid :global(.header__logo),
  .header.is-open :global(.header__logo) {
    --logo-h: var(--logo-solid);
  }

  .header__nav {
    margin-left: auto;
  }

  .header__nav ul {
    display: flex;
    gap: 0.25rem;
  }

  .header__nav a {
    position: relative;
    display: block;
    padding: 0.5rem 0.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--c-black);
    text-decoration: none;
  }

  /* Hover — тонкая линия, без плашек поверх видео */
  .header__nav a::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.2rem;
    height: 1.5px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--t-base) var(--ease);
  }

  .header__nav a:hover::after,
  .header__nav a.is-active::after {
    transform: scaleX(1);
  }

  .header__nav a.is-active {
    color: var(--c-blue);
  }

  .header__cta {
    min-height: 44px;
    padding-inline: 1.125rem;
    font-size: 0.9375rem;
    border-radius: var(--r-sm);
  }

  .header__burger {
    display: none;
    position: relative;
    width: 44px;
    height: 44px;
    margin-left: auto;
    margin-right: -10px;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .header__burger-line {
    position: absolute;
    left: 11px;
    right: 11px;
    height: 2px;
    border-radius: 2px;
    background: var(--c-black);
    transition: transform var(--t-base) var(--ease);
  }

  .header__burger-line--top {
    top: 17px;
  }

  .header__burger-line--bottom {
    top: 25px;
  }

  .is-open .header__burger-line--top {
    transform: translateY(4px) rotate(45deg);
  }

  .is-open .header__burger-line--bottom {
    transform: translateY(-4px) rotate(-45deg);
  }

  .menu {
    position: fixed;
    inset: calc(var(--header-h) + env(safe-area-inset-top)) 0 0;
    background: var(--c-white);
    overflow-y: auto;
    animation: fade-in var(--t-base) var(--ease);
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  .menu__inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 100%;
    padding-block: 0.5rem calc(1.5rem + env(safe-area-inset-bottom));
  }

  .menu__list li {
    border-bottom: 1px solid var(--c-line);
  }

  .menu__list a {
    display: grid;
    grid-template-columns: 2.25rem 1fr auto;
    align-items: center;
    padding-block: 1.1rem;
    text-decoration: none;
  }

  .menu__num {
    font-size: var(--fs-meta);
    font-weight: 700;
    color: var(--c-blue);
  }

  .menu__text {
    font-size: 1.625rem;
    font-weight: 700;
    letter-spacing: var(--tr-title);
  }

  :global(.menu__arrow) {
    width: 20px;
    height: 20px;
    color: var(--c-ink-3);
  }

  .menu__cta {
    width: 100%;
    margin-top: 2rem;
  }

  @media (max-width: 1100px) {
    .header__nav,
    .header__cta {
      display: none;
    }

    .header__burger {
      display: block;
    }
  }

  @media (min-width: 1101px) {
    .menu {
      display: none;
    }
  }
</style>
