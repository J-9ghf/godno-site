---
import SectionTag from './SectionTag.astro';
import { caseGroups, about } from '../data/content';

const group = caseGroups.find((g) => g.id === 'consulting')!;
const hiringCount = caseGroups.find((g) => g.id === 'hiring')!.cases.length;

// Заголовок — фраза из блока «О нас», без изменений
const quote = about.paragraphs[2];
const heading = quote.slice(0, quote.indexOf(':'));
const hlFrom = heading.indexOf('сломана');
---

<section class="section consulting" id="consulting" aria-labelledby="consulting-title">
  <div class="container">
    <SectionTag num="05" label={group.title} aside={`${group.cases.length} проекта`} />

    <h2 class="h2 consulting__title" id="consulting-title" data-reveal>
      {heading.slice(0, hlFrom)}<span class="hl">{heading.slice(hlFrom)}</span>
    </h2>

    <div class="consulting__cases grid">
      {
        group.cases.map((c, i) => (
          <article class="dossier" id={`case-${c.id}`} aria-labelledby={`case-${c.id}-title`} data-reveal style={`--d: ${i * 140}`}>
            <div class="dossier__top">
              <span class="dossier__num bignum">{String(hiringCount + i + 1).padStart(2, '0')}</span>
              <span class="dossier__status eyebrow">Проект продолжается</span>
            </div>

            <h3 class="h3 dossier__title" id={`case-${c.id}-title`}>{c.title}</h3>

            <dl class="dossier__meta">
              <div>
                <dt class="eyebrow">{c.metaLabel}</dt>
                <dd>{c.metaValue}</dd>
              </div>
              <div>
                <dt class="eyebrow">Сфера</dt>
                <dd>{c.sphere}</dd>
              </div>
            </dl>

            <ol class="dossier__steps">
              {c.body.map((p, j) => (
                <li>
                  <span class="dossier__step-num eyebrow num" aria-hidden="true">{String(j + 1).padStart(2, '0')}</span>
                  <p>{p}</p>
                </li>
              ))}
            </ol>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .consulting {
    background: var(--c-blue-light);
    scroll-margin-top: var(--header-h);
  }

  .consulting__title {
    max-width: 18ch;
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
    font-size: var(--fs-display);
  }

  .consulting__cases {
    row-gap: 4rem;
    margin-top: clamp(3.5rem, 7vw, 6rem);
  }

  .dossier {
    grid-column: span 6;
    display: flex;
    flex-direction: column;
    padding-top: 1.5rem;
    border-top: 1px solid var(--c-black);
  }

  .dossier__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .dossier__num {
    color: var(--c-blue);
  }

  .dossier__status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--c-blue);
  }

  .dossier__status::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .dossier__title {
    max-width: 20ch;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .dossier__meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gutter);
    margin-top: 2rem;
    padding-block: 1rem;
    border-block: 1px solid var(--c-blue-light-2);
  }

  .dossier__meta dt {
    color: var(--c-ink-3);
  }

  .dossier__meta dd {
    margin-top: 0.35rem;
    font-size: var(--fs-small);
    font-weight: 700;
  }

  .dossier__meta dd::first-letter {
    text-transform: uppercase;
  }

  /* Абзацы — этапы на вертикальной тонкой линии */
  .dossier__steps {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    margin-top: 2.25rem;
    padding-left: 3.25rem;
  }

  .dossier__steps::before {
    content: '';
    position: absolute;
    left: 0.6875rem;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: var(--c-blue-light-2);
  }

  .dossier__steps li {
    position: relative;
    font-size: var(--fs-small);
    line-height: 1.7;
    color: var(--c-ink-2);
  }

  .dossier__steps li:first-child p {
    font-size: var(--fs-body);
    font-weight: 500;
    color: var(--c-black);
  }

  .dossier__step-num {
    position: absolute;
    left: -3.25rem;
    top: 0.1rem;
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    padding: 0;
    background: var(--c-blue-light);
    color: var(--c-blue);
    letter-spacing: 0;
  }

  @media (max-width: 960px) {
    .dossier {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .dossier__steps {
      padding-left: 2.5rem;
    }

    .dossier__step-num {
      left: -2.5rem;
    }
  }
</style>
