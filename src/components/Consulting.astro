---
import SectionTag from './SectionTag.astro';
import { caseGroups, about } from '../data/content';

const group = caseGroups.find((g) => g.id === 'consulting')!;
const hiringCount = caseGroups.find((g) => g.id === 'hiring')!.cases.length;

// Заголовок — фраза из блока «О нас», без изменений
const quote = about.paragraphs[2];
const heading = quote.slice(0, quote.indexOf(':'));
const hlFrom = heading.indexOf('сломана');
---

<section class="section section--mist consulting" id="consulting" aria-labelledby="consulting-title">
  <div class="container">
    <SectionTag num="05" label={group.title} aside={`${group.cases.length} проекта`} />

    <h2 class="h2 consulting__title" id="consulting-title" data-reveal>
      {heading.slice(0, hlFrom)}<span class="hl">{heading.slice(hlFrom)}</span>
    </h2>

    <div class="consulting__cases grid">
      {
        group.cases.map((c, i) => (
          <article class:list={['dossier', i % 2 === 1 ? 'dossier--navy' : 'dossier--white']} id={`case-${c.id}`} aria-labelledby={`case-${c.id}-title`} data-reveal style={`--d: ${i * 140}`}>
            <div class="dossier__top">
              <span class="dossier__num bignum">{String(hiringCount + i + 1).padStart(2, '0')}</span>
              <span class="dossier__status eyebrow"><span class="node" aria-hidden="true" />Проект продолжается</span>
            </div>

            <h3 class="h3 dossier__title" id={`case-${c.id}-title`}>{c.title}</h3>

            <dl class="dossier__meta">
              <div>
                <dt class="eyebrow">{c.metaLabel}</dt>
                <dd>{c.metaValue}</dd>
              </div>
              <div>
                <dt class="eyebrow">Сфера</dt>
                <dd>{c.sphere}</dd>
              </div>
            </dl>

            <ol class="dossier__steps">
              {c.body.map((p, j) => (
                <li>
                  <span class="dossier__step-num eyebrow num" aria-hidden="true">{String(j + 1).padStart(2, '0')}</span>
                  <p>{p}</p>
                </li>
              ))}
            </ol>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .consulting {
    scroll-margin-top: var(--header-h);
  }

  .consulting__title {
    max-width: 18ch;
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
    font-size: var(--fs-display);
  }

  .consulting__cases {
    row-gap: var(--gutter);
    margin-top: clamp(3.5rem, 7vw, 6rem);
    align-items: start;
  }

  /* Две поверхности вместо рамок: белая и глубокая */
  .dossier {
    grid-column: span 6;
    display: flex;
    flex-direction: column;
    padding: clamp(1.75rem, 3.5vw, 3.25rem);
    background: var(--d-bg);
    color: var(--d-fg);
  }

  .dossier--white {
    --d-bg: var(--c-white);
    --d-fg: var(--c-ink);
    --d-muted: var(--c-slate);
    --d-accent: var(--c-accent);
    --d-chip: var(--c-accent-tint);
  }

  .dossier--navy {
    --d-bg: var(--c-navy);
    --d-fg: var(--c-white);
    --d-muted: var(--c-on-navy-2);
    --d-accent: var(--c-accent-bright);
    --d-chip: rgb(var(--bright-rgb) / 0.14);
    margin-top: clamp(0rem, 8vw, 7rem);
  }

  .dossier__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .dossier__num {
    color: var(--d-accent);
  }

  .dossier__status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--d-accent);
  }

  .dossier__status :global(.node) {
    background: var(--d-accent);
  }

  .dossier__title {
    max-width: 20ch;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .dossier__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem 3rem;
    margin-top: 1.75rem;
  }

  .dossier__meta dt {
    color: var(--d-muted);
  }

  .dossier__meta dd {
    margin-top: 0.35rem;
    font-size: var(--fs-small);
    font-weight: 700;
  }

  .dossier__meta dd::first-letter {
    text-transform: uppercase;
  }

  /* Абзацы — этапы с номерами-узлами */
  .dossier__steps {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    margin-top: 2.5rem;
  }

  .dossier__steps li {
    display: grid;
    grid-template-columns: 2rem 1fr;
    gap: 1rem;
    font-size: var(--fs-small);
    line-height: 1.7;
    color: var(--d-muted);
  }

  .dossier__steps li:first-child p {
    font-size: var(--fs-body);
    font-weight: 500;
    color: var(--d-fg);
  }

  .dossier__step-num {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    background: var(--d-chip);
    color: var(--d-accent);
    letter-spacing: 0;
  }

  @media (max-width: 960px) {
    .dossier {
      grid-column: 1 / -1;
    }

    .dossier--navy {
      margin-top: 0;
    }
  }
</style>
