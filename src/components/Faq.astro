---
import SectionTag from './SectionTag.astro';
import Icon from './Icon.astro';
import { faq } from '../data/content';
---

<section class="section section--soft faq" id="faq" aria-labelledby="faq-title">
  <div class="container grid">
    <div class="faq__aside">
      <SectionTag num="07" label="FAQ" onSoft />
      <h2 class="h2" id="faq-title" data-reveal>Частые <span class="hl">вопросы</span></h2>
    </div>

    <ul class="faq__list">
      {
        faq.map((item, i) => (
          <li class="qa" data-accordion data-reveal style={`--d: ${i * 50}`}>
            <h3 class="qa__heading">
              <button
                class="qa__trigger"
                id={`faq-${i}-btn`}
                type="button"
                aria-expanded="false"
                aria-controls={`faq-${i}-panel`}
                data-accordion-trigger
              >
                <span class="qa__q">{item.q}</span>
                <span class="qa__toggle" aria-hidden="true">
                  <Icon name="plus" />
                </span>
              </button>
            </h3>
            <div class="qa__panel" id={`faq-${i}-panel`} role="region" aria-labelledby={`faq-${i}-btn`} data-accordion-panel>
              <div class="qa__panel-inner">
                <p class="qa__a">{item.a}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .faq__aside {
    grid-column: 1 / span 4;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.75rem;
  }

  .faq__list {
    grid-column: 6 / -1;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .qa {
    border-radius: var(--r-lg);
    background: var(--c-white);
    transition:
      opacity var(--t-slow) var(--ease) calc(var(--d, 0) * 1ms),
      transform var(--t-slow) var(--ease) calc(var(--d, 0) * 1ms),
      box-shadow var(--t-base) var(--ease) 0s;
  }

  .qa:hover,
  .qa.is-open {
    box-shadow: 0 0 0 1px var(--c-blue-light-2);
  }

  .qa__heading {
    font: inherit;
  }

  .qa__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    width: 100%;
    padding: 1.25rem 1.25rem 1.25rem 1.75rem;
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
  }

  .qa__q {
    font-size: var(--fs-h4);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  .qa__toggle {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: var(--r-md);
    background: var(--c-blue-light);
    color: var(--c-blue);
    transition:
      background-color var(--t-base) var(--ease),
      color var(--t-base) var(--ease);
  }

  :global(.qa__toggle svg) {
    width: 18px;
    height: 18px;
    transition: transform var(--t-base) var(--ease);
  }

  .qa__trigger:hover .qa__toggle,
  .qa.is-open .qa__toggle {
    background: var(--c-blue);
    color: var(--c-white);
  }

  .qa.is-open :global(.qa__toggle svg) {
    transform: rotate(45deg);
  }

  .qa__panel {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.45s var(--ease);
  }

  :global(.js) .qa:not(.is-open) .qa__panel {
    grid-template-rows: 0fr;
  }

  .qa__panel-inner {
    min-height: 0;
    overflow: hidden;
  }

  :global(.js) .qa:not(.is-open) .qa__panel-inner {
    visibility: hidden;
    transition: visibility 0s 0.45s;
  }

  .qa__a {
    max-width: 60ch;
    padding: 0 5rem 1.5rem 1.75rem;
    color: var(--c-ink-2);
  }

  @media (max-width: 960px) {
    .faq__aside,
    .faq__list {
      grid-column: 1 / -1;
    }

    .faq__aside {
      margin-bottom: 2.5rem;
    }
  }

  @media (max-width: 640px) {
    .qa__trigger {
      padding: 1rem 1rem 1rem 1.25rem;
      gap: 1rem;
    }

    .qa__a {
      padding: 0 1.25rem 1.25rem;
    }
  }
</style>
