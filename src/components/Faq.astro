---
import SectionTag from './SectionTag.astro';
import { faq } from '../data/content';
---

<section class="section faq" id="faq" aria-labelledby="faq-title">
  <div class="container">
    <SectionTag num="08" label="FAQ" aside={`${faq.length} вопросов`} />

    <div class="faq__grid grid">
      <h2 class="h2 faq__title" id="faq-title" data-reveal>Частые <span class="hl">вопросы</span></h2>

      <ul class="faq__list">
        {
          faq.map((item, i) => (
            <li class="qa" data-accordion>
              <h3 class="qa__heading">
                <button
                  class="qa__trigger"
                  id={`faq-${i}-btn`}
                  type="button"
                  aria-expanded="false"
                  aria-controls={`faq-${i}-panel`}
                  data-accordion-trigger
                >
                  <span class="qa__num eyebrow num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="qa__q">{item.q}</span>
                  <span class="qa__icon" aria-hidden="true" />
                </button>
              </h3>
              <div class="qa__panel" id={`faq-${i}-panel`} role="region" aria-labelledby={`faq-${i}-btn`} data-accordion-panel>
                <div class="qa__panel-inner">
                  <p class="qa__a">{item.a}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .faq__grid {
    row-gap: 3rem;
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
  }

  .faq__title {
    grid-column: 1 / span 4;
    align-self: start;
    max-width: 7ch;
    font-size: var(--fs-display);
  }

  .faq__list {
    grid-column: 6 / -1;
    border-top: 1px solid var(--c-black);
  }

  .qa {
    border-bottom: 1px solid var(--c-line-strong);
  }

  .qa__heading {
    font: inherit;
  }

  /* Строгий accordion: строка, тонкая линия, «+» справа */
  .qa__trigger {
    display: grid;
    grid-template-columns: 3rem 1fr 20px;
    align-items: baseline;
    gap: 1rem;
    width: 100%;
    padding-block: clamp(1.5rem, 2.4vw, 2rem);
    border: 0;
    background: none;
    text-align: left;
    cursor: pointer;
  }

  .qa__num {
    color: var(--c-ink-3);
    transition: color var(--t-base) var(--ease);
  }

  .qa__q {
    font-size: clamp(1.1875rem, 1.05rem + 0.5vw, 1.5rem);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.02em;
    transition: color var(--t-base) var(--ease);
  }

  .qa__icon {
    position: relative;
    width: 20px;
    height: 20px;
    align-self: center;
  }

  .qa__icon::before,
  .qa__icon::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: var(--c-black);
    transition:
      transform var(--t-base) var(--ease),
      background-color var(--t-base) var(--ease);
  }

  .qa__icon::after {
    transform: rotate(90deg);
  }

  .qa__trigger:hover .qa__q,
  .qa.is-open .qa__q {
    color: var(--c-blue);
  }

  .qa__trigger:hover .qa__num,
  .qa.is-open .qa__num {
    color: var(--c-blue);
  }

  .qa.is-open .qa__icon::after {
    transform: rotate(0deg);
  }

  .qa.is-open .qa__icon::before,
  .qa.is-open .qa__icon::after {
    background: var(--c-blue);
  }

  .qa__panel {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.45s var(--ease);
  }

  :global(.js) .qa:not(.is-open) .qa__panel {
    grid-template-rows: 0fr;
  }

  .qa__panel-inner {
    min-height: 0;
    overflow: hidden;
  }

  :global(.js) .qa:not(.is-open) .qa__panel-inner {
    visibility: hidden;
    transition: visibility 0s 0.45s;
  }

  .qa__a {
    max-width: 58ch;
    padding: 0 3rem 2rem 4rem;
    color: var(--c-ink-2);
  }

  @media (max-width: 960px) {
    .faq__title,
    .faq__list {
      grid-column: 1 / -1;
    }

    .faq__title {
      max-width: none;
    }
  }

  @media (max-width: 640px) {
    .qa__trigger {
      grid-template-columns: 2rem 1fr 18px;
      gap: 0.75rem;
    }

    .qa__a {
      padding: 0 0 1.5rem 2.75rem;
    }
  }
</style>
