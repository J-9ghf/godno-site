---
import SectionTag from './SectionTag.astro';
import { reviews } from '../data/content';

const items = reviews.items;
const total = items.length + 1;
const pad = (n: number) => String(n).padStart(2, '0');

// Асимметричная раскладка: у каждой цитаты своё место в 12-колоночной сетке и свой размер текста
const layout = [
  { item: items[0], place: 'q-a', size: 'l' },
  { item: items[2], place: 'q-b', size: 'm' },
  { item: items[1], place: 'q-c', size: 's' },
  { item: items[4], place: 'q-d', size: 's' },
  { item: items[5], place: 'q-e', size: 's' },
  { item: items[3], place: 'q-f', size: 'm' },
  { item: items[6], place: 'q-g', size: 's' },
];
---

<section class="section reviews" id="reviews" aria-labelledby="reviews-title">
  <div class="container">
    <SectionTag num="07" label="Отзывы" aside="Дословно" />
    <h2 class="visually-hidden" id="reviews-title">Отзывы клиентов</h2>

    <figure class="lead-quote grid" data-reveal>
      <span class="lead-quote__mark" aria-hidden="true">«</span>
      <blockquote class="lead-quote__text">
        <p>{reviews.featured}</p>
      </blockquote>
      <figcaption class="lead-quote__cap eyebrow num"><span>01</span> / {pad(total)}</figcaption>
    </figure>

    <div class="quotes grid">
      {
        layout.map((q, i) => (
          <figure class:list={['quote', q.place, `quote--${q.size}`]} data-reveal style={`--d: ${(i % 3) * 90}`}>
            <figcaption class="quote__num eyebrow num"><span class="node" aria-hidden="true" />{pad(i + 2)}</figcaption>
            <blockquote class="quote__text">
              <p>{q.item.text}</p>
            </blockquote>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Главная цитата — на глубоком цветовом поле */
  .lead-quote {
    align-items: start;
    row-gap: 2rem;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding: clamp(2.5rem, 6vw, 5.5rem) clamp(1.5rem, 5vw, 4.5rem);
    background: var(--c-navy);
    color: var(--c-white);
  }

  .lead-quote__mark {
    grid-column: 1;
    font-size: clamp(4rem, 2.5rem + 5vw, 8rem);
    font-weight: 700;
    line-height: 0.75;
    color: var(--c-accent-bright);
  }

  .lead-quote__text {
    grid-column: 2 / span 10;
    font-size: clamp(1.5rem, 1rem + 1.8vw, 2.75rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-wrap: pretty;
    white-space: pre-line;
  }

  .lead-quote__cap {
    grid-column: 2 / span 10;
    color: var(--c-on-navy-2);
  }

  .lead-quote__cap span {
    color: var(--c-accent-bright);
  }

  /* Мозаика: без линий — поверхность, размер и позиция */
  .quotes {
    row-gap: clamp(2.5rem, 5vw, 4rem);
    margin-top: clamp(4rem, 8vw, 6.5rem);
    align-items: start;
  }

  .quote {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .quote--m,
  .quote--l {
    padding: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--c-white);
  }

  .q-a {
    grid-column: 1 / span 6;
  }

  .q-b {
    grid-column: 8 / span 5;
    margin-top: clamp(0rem, 6vw, 5rem);
  }

  .q-c {
    grid-column: 1 / span 3;
  }

  .q-d {
    grid-column: 5 / span 4;
  }

  .q-e {
    grid-column: 10 / span 3;
  }

  .q-f {
    grid-column: 3 / span 6;
  }

  .q-g {
    grid-column: 10 / span 3;
    align-self: center;
  }

  .quote__num {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--c-accent);
  }

  .quote__text {
    white-space: pre-line;
  }

  .quote--l .quote__text {
    font-size: clamp(1.25rem, 1.05rem + 0.7vw, 1.75rem);
    font-weight: 600;
    line-height: 1.32;
    letter-spacing: -0.02em;
  }

  .quote--m .quote__text {
    font-size: clamp(1.125rem, 1.02rem + 0.35vw, 1.375rem);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.015em;
  }

  .quote--s .quote__text {
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--c-slate);
  }

  @media (max-width: 1024px) {
    .q-a,
    .q-b,
    .q-f {
      grid-column: 1 / span 8;
      margin-top: 0;
    }

    .q-c,
    .q-d,
    .q-e,
    .q-g {
      grid-column: span 6;
    }
  }

  @media (max-width: 640px) {
    .lead-quote__mark,
    .lead-quote__text,
    .lead-quote__cap {
      grid-column: 1 / -1;
    }

    .lead-quote {
      row-gap: 1rem;
      margin-inline: calc(var(--pad) * -1);
    }

    .q-a,
    .q-b,
    .q-c,
    .q-d,
    .q-e,
    .q-f,
    .q-g {
      grid-column: 1 / -1;
    }
  }
</style>
