---
import SectionTag from './SectionTag.astro';
import { reviews } from '../data/content';

const total = reviews.items.length + 1;
---

<section class="reviews" id="reviews" aria-labelledby="reviews-title">
  <div class="container">
    <div class="reviews__head grid">
      <SectionTag num="05" label="Отзывы" class="reviews__tag" />
      <h2 class="visually-hidden" id="reviews-title">Отзывы клиентов</h2>
      <p class="reviews__note label muted">Дословно, из переписки с клиентами</p>
    </div>

    <figure class="lead-quote grid" data-reveal>
      <span class="lead-quote__mark serif" aria-hidden="true">«</span>
      <blockquote class="lead-quote__text serif">
        <p>{reviews.featured}</p>
      </blockquote>
      <figcaption class="lead-quote__cap label">
        <span class="section-tag__num">01</span> / {String(total).padStart(2, '0')} · Отзыв клиента
      </figcaption>
    </figure>

    <div class="quotes" data-slider>
      <ul class="quotes__track" data-slider-track>
        {
          reviews.items.map((r, i) => (
            <li class:list={['quote', `quote--${r.size}`]} data-reveal style={`--reveal-delay: ${(i % 3) * 90}`}>
              <figure>
                <figcaption class="quote__num label">
                  {String(i + 2).padStart(2, '0')}
                </figcaption>
                <blockquote class="quote__text">
                  <p>{r.text}</p>
                </blockquote>
              </figure>
            </li>
          ))
        }
      </ul>
      <div class="quotes__controls" aria-hidden="true">
        <span class="quotes__progress"><span data-slider-progress></span></span>
        <span class="label muted">Листайте</span>
      </div>
    </div>
  </div>
</section>

<style>
  .reviews {
    padding-block: var(--space-section-s) var(--space-section);
    border-top: 1px solid var(--line);
  }

  .reviews__head {
    align-items: baseline;
    margin-bottom: clamp(3rem, 6vw, 5.5rem);
  }

  :global(.reviews__tag) {
    grid-column: 1 / span 6;
  }

  .reviews__note {
    grid-column: 7 / -1;
    text-align: right;
  }

  .lead-quote {
    position: relative;
    row-gap: 2.5rem;
  }

  .lead-quote__mark {
    grid-column: 1 / span 1;
    font-size: clamp(5rem, 3rem + 6vw, 10rem);
    line-height: 0.7;
    color: var(--accent);
  }

  .lead-quote__text {
    grid-column: 2 / span 10;
    font-size: clamp(1.6rem, 1.05rem + 2vw, 3.1rem);
    font-weight: 360;
    line-height: 1.2;
    letter-spacing: -0.018em;
    text-wrap: pretty;
  }

  .lead-quote__cap {
    grid-column: 2 / span 10;
    color: var(--ink-3);
  }

  /* Мозаика цитат */
  .quotes {
    margin-top: clamp(5rem, 9vw, 8rem);
  }

  .quotes__track {
    columns: 3;
    column-gap: var(--gutter);
  }

  .quote {
    break-inside: avoid;
    margin-bottom: clamp(2.5rem, 4vw, 3.75rem);
    padding-top: 1rem;
    border-top: 1px solid var(--line-strong);
  }

  .quote__num {
    margin-bottom: 1.25rem;
    color: var(--accent);
  }

  .quote__text {
    white-space: pre-line;
    color: var(--ink-2);
  }

  .quote--l .quote__text {
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 1.1rem + 0.6vw, 1.65rem);
    line-height: 1.32;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .quote--m .quote__text {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.4;
    color: var(--ink);
  }

  .quote--s .quote__text {
    font-size: var(--fs-body);
    line-height: 1.55;
  }

  .quote--l {
    padding: 1.5rem 1.5rem 1.75rem;
    background: var(--paper-2);
    border-top-color: var(--ink);
  }

  .quotes__controls {
    display: none;
  }

  @media (max-width: 1024px) {
    .quotes__track {
      columns: 2;
    }
  }

  /* Мобильный: горизонтальный слайдер со snap */
  @media (max-width: 640px) {
    :global(.reviews__tag),
    .reviews__note {
      grid-column: 1 / -1;
      text-align: left;
    }

    .reviews__note {
      margin-top: 0.75rem;
    }

    .lead-quote {
      row-gap: 1rem;
    }

    .lead-quote__mark,
    .lead-quote__text,
    .lead-quote__cap {
      grid-column: 1 / -1;
    }

    .lead-quote__mark {
      font-size: 5rem;
      line-height: 0.6;
    }

    .quotes {
      margin-inline: calc(var(--pad) * -1);
    }

    .quotes__track {
      columns: auto;
      display: flex;
      gap: 12px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--pad);
      padding-inline: var(--pad);
      scrollbar-width: none;
    }

    .quotes__track::-webkit-scrollbar {
      display: none;
    }

    /* Карточки за пределами экрана по горизонтали не пересекают viewport — без reveal */
    :global(.js) .quote[data-reveal] {
      opacity: 1;
      transform: none;
    }

    .quote {
      flex: 0 0 84%;
      margin: 0;
      padding: 1.25rem 1.25rem 1.5rem;
      background: var(--paper-2);
      scroll-snap-align: start;
    }

    .quote--l .quote__text {
      font-size: 1.2rem;
    }

    .quotes__controls {
      display: flex;
      align-items: center;
      gap: 1rem;
      margin-top: 1.5rem;
      padding-inline: var(--pad);
    }

    .quotes__progress {
      position: relative;
      flex: 1;
      height: 1px;
      background: var(--line-strong);
    }

    .quotes__progress span {
      position: absolute;
      inset: -0.5px auto -0.5px 0;
      width: 100%;
      background: var(--ink);
      transform: scaleX(var(--p, 0.15));
      transform-origin: left;
      transition: transform 0.2s linear;
    }
  }
</style>
