---
import SectionTag from './SectionTag.astro';
import CaseRow from './CaseRow.astro';
import Icon from './Icon.astro';
import { caseGroups } from '../data/content';

const hiring = caseGroups.find((g) => g.id === 'hiring')!;
const consulting = caseGroups.find((g) => g.id === 'consulting')!;
const also = caseGroups.find((g) => g.id === 'also')!;

// Сквозная нумерация: подбор 01–04, консалтинг 05–06, также находили 07–09
const pad = (n: number) => String(n).padStart(2, '0');
const alsoStart = hiring.cases.length + consulting.cases.length;
const index = [
  { title: hiring.title, href: '#cases-hiring', range: `01–${pad(hiring.cases.length)}` },
  { title: consulting.title, href: '#consulting', range: `${pad(hiring.cases.length + 1)}–${pad(alsoStart)}` },
  { title: also.title, href: '#cases-also', range: `${pad(alsoStart + 1)}–${pad(alsoStart + also.cases.length)}` },
];
---

<section class="section cases" id="cases" aria-labelledby="cases-title">
  <div class="container">
    <SectionTag num="04" label="Опыт" aside={`${hiring.cases.length + consulting.cases.length + also.cases.length} кейсов`} />

    <div class="cases__head grid">
      <h2 class="h2 cases__title" id="cases-title" data-reveal>
        Подбор <span class="hl">ключевых сотрудников</span>
      </h2>

      <nav class="cases__index" aria-label="Разделы опыта" data-reveal style="--d: 120">
        <ol>
          {
            index.map((it) => (
              <li>
                <a href={it.href}>
                  <span class="cases__index-range eyebrow num">{it.range}</span>
                  <span class="cases__index-title">{it.title}</span>
                  <Icon name="arrow-down" class="cases__index-icon" />
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>

    <div class="cases__list" id="cases-hiring">
      {hiring.cases.map((c, i) => <CaseRow item={c} num={pad(i + 1)} open={i === 0} />)}
    </div>

    <div class="cases__also" id="cases-also">
      <p class="shead cases__also-head">
        <span class="eyebrow shead__num num">{pad(alsoStart + 1)}–{pad(alsoStart + also.cases.length)}</span>
        <span class="eyebrow">{also.title}</span>
      </p>
      <div class="cases__list cases__list--compact">
        {also.cases.map((c, i) => <CaseRow item={c} num={pad(alsoStart + i + 1)} compact />)}
      </div>
    </div>
  </div>
</section>

<style>
  .cases__head {
    align-items: end;
    row-gap: 2.5rem;
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .cases__title {
    grid-column: 1 / span 8;
    max-width: 13ch;
    font-size: var(--fs-display);
  }

  .cases__index {
    grid-column: 9 / -1;
  }

  .cases__index li {
    border-top: 1px solid var(--c-line-strong);
  }

  .cases__index li:last-child {
    border-bottom: 1px solid var(--c-line-strong);
  }

  .cases__index a {
    display: grid;
    grid-template-columns: 4.5rem 1fr 18px;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.875rem;
    font-size: var(--fs-small);
    font-weight: 700;
    text-decoration: none;
    transition: color var(--t-fast) var(--ease);
  }

  .cases__index a:hover {
    color: var(--c-blue);
  }

  .cases__index-range {
    color: var(--c-blue);
  }

  :global(.cases__index-icon) {
    width: 16px;
    height: 16px;
    color: var(--c-ink-3);
  }

  .cases__list {
    border-top: 1px solid var(--c-black);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .cases__also {
    margin-top: clamp(5rem, 9vw, 8rem);
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .cases__also-head {
    border-top: 0;
    padding-top: 0;
    margin-bottom: 1.25rem;
  }

  @media (max-width: 960px) {
    .cases__title,
    .cases__index {
      grid-column: 1 / -1;
    }
  }
</style>
