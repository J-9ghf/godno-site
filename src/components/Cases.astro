---
import SectionTag from './SectionTag.astro';
import CaseStory from './CaseStory.astro';
import Icon from './Icon.astro';
import { caseGroups } from '../data/content';

const hiring = caseGroups.find((g) => g.id === 'hiring')!;
const consulting = caseGroups.find((g) => g.id === 'consulting')!;
const also = caseGroups.find((g) => g.id === 'also')!;

// Сквозная нумерация: подбор 01–04, консалтинг 05–06, также находили 07–09
const pad = (n: number) => String(n).padStart(2, '0');
const alsoStart = hiring.cases.length + consulting.cases.length;
const index = [
  { title: hiring.title, href: '#experience-list', range: `01–${pad(hiring.cases.length)}` },
  { title: consulting.title, href: '#consulting', range: `${pad(hiring.cases.length + 1)}–${pad(alsoStart)}` },
  { title: also.title, href: '#also', range: `${pad(alsoStart + 1)}–${pad(alsoStart + also.cases.length)}` },
];
---

<section class="section cases" id="experience" aria-labelledby="cases-title">
  <div class="container">
    <SectionTag num="04" label="Опыт" aside={`${hiring.cases.length + consulting.cases.length + also.cases.length} кейсов`} />

    <div class="cases__head grid">
      <h2 class="h2 cases__title" id="cases-title" data-reveal>
        Подбор <span class="hl">ключевых сотрудников</span>
      </h2>

      <!-- Компьютер: фото слева, заголовок и оглавление справа. Планшет и телефон: под заголовком -->
      <figure class="cases__photo" data-reveal>
        <img
          src="/images/team-v2.webp"
          alt="Сотрудники работают за общим столом в светлом офисе"
          width="1200"
          height="800"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <nav class="cases__index" aria-label="Разделы опыта" data-reveal style="--d: 120">
        <ol>
          {
            index.map((it) => (
              <li>
                <a href={it.href}>
                  <span class="cases__index-range eyebrow num">{it.range}</span>
                  <span class="cases__index-title">{it.title}</span>
                  <Icon name="arrow-down" class="cases__index-icon" />
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </div>

    <div class="cases__list" id="experience-list">
      {hiring.cases.map((c, i) => <CaseStory item={c} num={pad(i + 1)} index={i} lead={i === 0} />)}
    </div>
  </div>
</section>

<style>
  .cases__head {
    grid-template-rows: auto 1fr;
    align-items: stretch;
    row-gap: 2.5rem;
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
    margin-bottom: clamp(4rem, 8vw, 7rem);
  }

  .cases__title {
    grid-column: 7 / -1;
    grid-row: 1;
    align-self: start;
    max-width: 13ch;
    font-size: var(--fs-display);
  }

  .cases__index {
    grid-column: 7 / -1;
    grid-row: 2;
    align-self: end;
  }

  /* Фото (чёрно-белое) — по высоте колонки с заголовком и оглавлением */
  .cases__photo {
    grid-column: 1 / span 6;
    grid-row: 1 / span 2;
    margin: 0;
  }

  .cases__photo img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    object-position: 50% 30%;
    background: var(--c-mist);
  }

  .cases__index ol {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .cases__index a {
    display: grid;
    grid-template-columns: 4.5rem 1fr 18px;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: var(--c-white);
    font-size: var(--fs-small);
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color var(--t-fast) var(--ease),
      color var(--t-fast) var(--ease);
  }

  .cases__index a:hover {
    background: var(--c-accent-tint);
    color: var(--c-accent-deep);
  }

  .cases__index-range {
    color: var(--c-accent);
  }

  :global(.cases__index-icon) {
    width: 16px;
    height: 16px;
    color: var(--c-slate-2);
  }

  .cases__list {
    display: flex;
    flex-direction: column;
    gap: clamp(5rem, 10vw, 9rem);
    scroll-margin-top: calc(var(--header-h) + 2rem);
  }

  @media (max-width: 960px) {
    .cases__head {
      grid-template-rows: auto;
    }

    .cases__title,
    .cases__photo,
    .cases__index {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .cases__photo img {
      height: auto;
    }
  }

  /* Телефон: кадр 4:3, все лица в кадре */
  @media (max-width: 640px) {
    .cases__photo img {
      aspect-ratio: 4 / 3;
      object-position: 60% 30%;
    }
  }
</style>
