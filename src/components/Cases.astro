---
import SectionTag from './SectionTag.astro';
import CaseRow from './CaseRow.astro';
import Icon from './Icon.astro';
import { caseGroups } from '../data/content';

const hiring = caseGroups.find((g) => g.id === 'hiring')!;
const consulting = caseGroups.find((g) => g.id === 'consulting')!;
const also = caseGroups.find((g) => g.id === 'also')!;

// Сквозная нумерация: подбор 01–04, консалтинг 05–06, также находили 07–09
const pad = (n: number) => String(n).padStart(2, '0');
const index = [
  { title: hiring.title, href: '#cases-hiring', count: hiring.cases.length },
  { title: consulting.title, href: '#consulting', count: consulting.cases.length },
  { title: also.title, href: '#cases-also', count: also.cases.length },
];
const alsoStart = hiring.cases.length + consulting.cases.length;
---

<section class="section cases" id="cases" aria-labelledby="cases-title">
  <div class="container">
    <header class="cases__head grid">
      <div class="cases__title-wrap">
        <SectionTag num="04" label="Опыт" />
        <h2 class="h2" id="cases-title" data-reveal>
          Подбор ключевых сотрудников и <span class="hl">управленческий консалтинг</span>
        </h2>
      </div>

      <nav class="cases__index" aria-label="Разделы опыта" data-reveal style="--d: 120">
        <ol>
          {
            index.map((it, i) => (
              <li>
                <a href={it.href}>
                  <span class="cases__index-num num">{pad(i + 1)}</span>
                  <span class="cases__index-title">{it.title}</span>
                  <span class="cases__index-count num">{it.count}</span>
                  <Icon name="arrow-down" class="cases__index-icon" />
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
    </header>

    <div class="cases__group" id="cases-hiring">
      <h3 class="cases__group-title">
        <span class="check"><Icon name="check" /></span>
        {hiring.title}
      </h3>
      <div class="cases__list">
        {hiring.cases.map((c, i) => <CaseRow item={c} num={pad(i + 1)} open={i === 0} />)}
      </div>
    </div>

    <div class="cases__group cases__group--also" id="cases-also">
      <h3 class="cases__group-title">
        <span class="check"><Icon name="check" /></span>
        {also.title}
      </h3>
      <div class="cases__list">
        {also.cases.map((c, i) => <CaseRow item={c} num={pad(alsoStart + i + 1)} compact />)}
      </div>
    </div>
  </div>
</section>

<style>
  .cases__head {
    align-items: end;
    row-gap: 2.5rem;
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .cases__title-wrap {
    grid-column: 1 / span 7;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.75rem;
  }

  .cases__index {
    grid-column: 8 / -1;
  }

  .cases__index li + li {
    border-top: 1px solid var(--c-line);
  }

  .cases__index a {
    display: grid;
    grid-template-columns: 2.5rem 1fr auto 20px;
    align-items: center;
    gap: 0.75rem;
    padding: 0.9rem 0;
    font-weight: 700;
    text-decoration: none;
    transition: color var(--t-fast) var(--ease);
  }

  .cases__index a:hover {
    color: var(--c-blue);
  }

  .cases__index-num {
    font-size: var(--fs-meta);
    color: var(--c-blue);
  }

  .cases__index-count {
    display: grid;
    place-items: center;
    min-width: 1.75rem;
    height: 1.5rem;
    border-radius: 999px;
    background: var(--c-soft);
    font-size: 0.75rem;
    color: var(--c-ink-2);
  }

  :global(.cases__index-icon) {
    width: 16px;
    height: 16px;
    color: var(--c-ink-3);
  }

  .cases__group {
    scroll-margin-top: calc(var(--header-h) + 1rem);
  }

  .cases__group--also {
    margin-top: clamp(4rem, 7vw, 6rem);
  }

  .cases__group-title {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-bottom: 1.25rem;
    font-size: var(--fs-h4);
    font-weight: 700;
    letter-spacing: -0.015em;
  }

  .cases__list {
    border-bottom: 1px solid var(--c-line);
  }

  @media (max-width: 960px) {
    .cases__title-wrap,
    .cases__index {
      grid-column: 1 / -1;
    }
  }
</style>
