---
import SectionTag from './SectionTag.astro';
import { steps } from '../data/content';
---

<section class="process" id="process" aria-labelledby="process-title">
  <div class="container">
    <div class="process__head grid">
      <SectionTag num="06" label="Как работаем" class="process__tag" />
      <h2 class="h2 process__title" id="process-title" data-reveal>Как мы работаем</h2>
      <p class="process__aside label" data-reveal style="--reveal-delay: 120">
        Пять шагов — от первого разговора до работы после выхода сотрудника
      </p>
    </div>

    <ol class="steps">
      {
        steps.map((s, i) => (
          <li class="step" data-reveal style={`--reveal-delay: ${i * 110}`}>
            <div class="step__top">
              <span class="step__num serif" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              {s.mark && <span class="step__mark label">{s.mark}</span>}
            </div>
            <div class="step__body">
              <h3 class="step__title">
                <span class="visually-hidden">Шаг {i + 1}. </span>
                {s.title}
              </h3>
              <p class="step__text">{s.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process {
    padding-block: var(--space-section);
    background: var(--night);
    color: var(--night-ink);
  }

  .process :global(.section-tag) {
    color: var(--night-ink-2);
  }

  .process :global(.section-tag__num) {
    color: #d9765f;
  }

  .process__head {
    row-gap: 2rem;
    align-items: end;
    margin-bottom: clamp(3.5rem, 7vw, 6.5rem);
  }

  :global(.process__tag) {
    grid-column: 1 / -1;
  }

  .process__title {
    grid-column: 1 / span 7;
    font-size: clamp(2.6rem, 1.2rem + 5vw, 6.5rem);
    line-height: 0.96;
    letter-spacing: -0.03em;
  }

  .process__aside {
    grid-column: 9 / -1;
    max-width: 30ch;
    color: var(--night-ink-2);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    grid-template-rows: minmax(clamp(15rem, 34vh, 21rem), auto) auto;
    border-left: 1px solid var(--night-line);
  }

  .step {
    position: relative;
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 1.5rem;
    padding: 1.5rem clamp(1rem, 1.6vw, 1.75rem) 2rem;
    border-right: 1px solid var(--night-line);
    border-top: 1px solid var(--night-line);
    /* Объединяем с transition от [data-reveal], чтобы hover не отменял появление */
    transition:
      opacity 0.9s var(--ease) calc(var(--reveal-delay, 0) * 1ms),
      transform 0.9s var(--ease) calc(var(--reveal-delay, 0) * 1ms),
      background-color 0.5s var(--ease) 0s;
  }

  /* Акцентная линия сверху — «загорается» при появлении */
  .step::before {
    content: '';
    position: absolute;
    top: -1px;
    left: -1px;
    right: 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 1s var(--ease);
    transition-delay: calc(300ms + var(--reveal-delay, 0) * 2ms);
  }

  .step.is-visible::before,
  :global(html:not(.js)) .step::before {
    transform: scaleX(1);
  }

  .step:hover {
    background: var(--night-2);
  }

  .step__top {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.5rem;
  }

  .step__num {
    font-size: clamp(4rem, 2.5rem + 4.4vw, 8.5rem);
    font-weight: 280;
    line-height: 0.8;
    letter-spacing: -0.05em;
    color: var(--night-ink);
    font-variant-numeric: lining-nums;
    transition: color 0.5s var(--ease);
  }

  .step:hover .step__num {
    color: #d9765f;
  }

  .step__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
  }

  .step__mark {
    padding: 0.35rem 0.55rem;
    border: 1px solid #d9765f;
    color: #e79a86;
  }

  .step__title {
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 1.1rem + 0.5vw, 1.6rem);
    font-weight: 420;
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .step__text {
    font-size: var(--fs-small);
    line-height: 1.55;
    color: var(--night-ink-2);
  }

  @media (max-width: 1100px) {
    .steps {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      grid-template-rows: repeat(2, minmax(11rem, auto) auto);
    }

    .step {
      grid-column: span 2;
    }

    .step:nth-child(4),
    .step:nth-child(5) {
      grid-column: span 3;
    }
  }

  @media (max-width: 900px) {
    .process__title,
    .process__aside {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .steps {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      border-left: 0;
    }

    .step__top {
      justify-content: flex-start;
    }

    .step__mark {
      display: none;
    }

    .step,
    .step:nth-child(4),
    .step:nth-child(5) {
      grid-column: auto;
      display: grid;
      grid-row: auto;
      grid-template-columns: 4.25rem 1fr;
      grid-template-rows: none;
      gap: 1rem;
      padding: 1.5rem 0 2rem;
      border-right: 0;
    }

    .step:hover {
      background: none;
    }

    .step__num {
      font-size: 3.25rem;
    }
  }
</style>
