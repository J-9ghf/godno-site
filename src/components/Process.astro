---
import SectionTag from './SectionTag.astro';
import Icon from './Icon.astro';
import { steps } from '../data/content';
---

<section class="section process" id="process" aria-labelledby="process-title">
  <div class="container grid">
    <aside class="process__aside">
      <div class="process__sticky">
        <SectionTag num="06" label="Как работаем" />
        <h2 class="h2" id="process-title" data-reveal>Как мы <span class="hl">работаем</span></h2>

        <div class="process__meter" aria-hidden="true">
          <span class="process__chip num">
            Шаг <span data-step-current>1</span> из {steps.length}
          </span>
          <span class="process__bar"><span data-step-bar></span></span>
        </div>

        <a class="btn process__cta" href="#contact">
          Обсудить вашу задачу
          <Icon name="arrow-up-right" class="btn__icon" />
        </a>
      </div>
    </aside>

    <ol class="process__steps">
      {
        steps.map((s, i) => (
          <li class="step" data-step={i + 1} data-reveal>
            <span class="step__num num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="step__body">
              <h3 class="h3 step__title">
                <span class="visually-hidden">Шаг {i + 1}. </span>
                {s.title}
              </h3>
              <p class="step__text">{s.text}</p>
              {s.mark && <span class="step__mark">{s.mark}</span>}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .process__aside {
    grid-column: 1 / span 5;
  }

  .process__sticky {
    position: sticky;
    top: calc(var(--header-h) + 2.5rem);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.75rem;
  }

  .process__meter {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: min(100%, 22rem);
    margin-top: 0.5rem;
  }

  .process__chip {
    flex: none;
    padding: 0.375rem 0.75rem;
    border-radius: 999px;
    background: var(--c-blue-light);
    color: var(--c-blue);
    font-size: var(--fs-meta);
    font-weight: 700;
  }

  .process__bar {
    position: relative;
    flex: 1;
    height: 6px;
    border-radius: 999px;
    background: var(--c-blue-light);
    overflow: hidden;
  }

  .process__bar span {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--c-blue);
    transform: scaleX(var(--p, 0.2));
    transform-origin: left;
    transition: transform var(--t-slow) var(--ease);
  }

  .process__cta {
    margin-top: 0.5rem;
  }

  .process__steps {
    grid-column: 7 / -1;
    border-top: 1px solid var(--c-line);
  }

  .step {
    display: grid;
    grid-template-columns: minmax(6rem, 9rem) minmax(0, 1fr);
    gap: var(--gutter);
    padding-block: clamp(2rem, 3.5vw, 3rem);
    border-bottom: 1px solid var(--c-line);
  }

  .step__num {
    font-size: clamp(3rem, 2.2rem + 2.6vw, 5.25rem);
    font-weight: 800;
    line-height: 0.85;
    letter-spacing: -0.05em;
    color: var(--c-blue-light-2);
    transition: color var(--t-slow) var(--ease);
  }

  .step.is-current .step__num {
    color: var(--c-blue);
  }

  .step__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.875rem;
    padding-top: 0.25rem;
  }

  .step__text {
    max-width: 44ch;
    color: var(--c-ink-2);
  }

  .step__mark {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.25rem;
    padding: 0.375rem 0.75rem;
    border-radius: 999px;
    background: var(--c-blue-light);
    color: var(--c-blue);
    font-size: var(--fs-meta);
    font-weight: 700;
  }

  @media (max-width: 960px) {
    .process__aside,
    .process__steps {
      grid-column: 1 / -1;
    }

    .process__sticky {
      position: static;
      margin-bottom: 2.5rem;
    }

    .process__meter,
    .process__cta {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .step {
      grid-template-columns: 4.5rem minmax(0, 1fr);
      gap: 1rem;
    }

    .step__num {
      font-size: 2.75rem;
      color: var(--c-blue);
    }
  }
</style>
