---
import Logo from './Logo.astro';
import { nav, legalDocs } from '../data/content';

interface Props {
  base?: string;
}
const { base = '' } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__brand">
        <Logo variant="mono" class="footer__logo" />
        <p class="footer__descr">Подбор ключевых сотрудников, бизнес-аналитика и управленческий консалтинг.</p>
      </div>

      <nav class="footer__col" aria-label="Разделы сайта">
        <p class="footer__label">Разделы</p>
        <ul>
          {nav.map((item) => (
            <li><a href={`${base}${item.href}`}>{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav class="footer__col" aria-label="Документы">
        <p class="footer__label">Документы</p>
        <ul>
          {legalDocs.map((d) => (
            <li><a href={d.href}>{d.title}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="footer__bottom">
      <p>© {year} Институт кадровых решений</p>
      <a class="footer__up" href={`${base}#top`}>Наверх ↑</a>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(3.5rem, 6vw, 5rem) 2rem;
    background: var(--c-black);
    color: var(--c-on-dark);
  }

  .footer__top {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 3fr) minmax(0, 3fr);
    gap: var(--gutter);
    padding-bottom: clamp(3rem, 5vw, 4.5rem);
  }

  .footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .footer :global(.footer__logo) {
    --logo-h: 88px;
    color: var(--c-white);
  }

  .footer__descr {
    max-width: 30ch;
    font-size: var(--fs-small);
    color: var(--c-on-dark-2);
  }

  .footer__label {
    margin-bottom: 1rem;
    font-size: var(--fs-meta);
    font-weight: 700;
    color: var(--c-on-dark-2);
  }

  .footer__col li + li {
    margin-top: 0.625rem;
  }

  .footer__col a,
  .footer__up {
    font-size: var(--fs-small);
    font-weight: 600;
    text-decoration: none;
    transition: color var(--t-fast) var(--ease);
  }

  .footer__col a:hover,
  .footer__up:hover {
    color: var(--c-blue-on-dark);
  }

  .footer__bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--c-line-dark);
    font-size: var(--fs-meta);
    color: var(--c-on-dark-2);
  }

  @media (max-width: 760px) {
    .footer__top {
      grid-template-columns: 1fr 1fr;
      row-gap: 2.5rem;
    }

    .footer__brand {
      grid-column: 1 / -1;
    }
  }
</style>
