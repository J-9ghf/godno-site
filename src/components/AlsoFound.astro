---
import SectionTag from './SectionTag.astro';
import { caseGroups } from '../data/content';

const also = caseGroups.find((g) => g.id === 'also')!;
// Сквозная нумерация продолжается после консалтинга: 07–09
const start = caseGroups.filter((g) => g.id !== 'also').reduce((n, g) => n + g.cases.length, 0);
const pad = (n: number) => String(n).padStart(2, '0');
// Разная ширина колонок — по объёму текста
const spans = ['span-4', 'span-5', 'span-3'];
---

<section class="section also" id="also" aria-labelledby="also-title">
  <div class="container">
    <SectionTag num="06" label={also.title} aside={`${pad(start + 1)}–${pad(start + also.cases.length)}`} />

    <h2 class="h2 also__title" id="also-title" data-reveal>
      Также <span class="hl">находили</span>
    </h2>

    <div class="also__grid grid">
      {
        also.cases.map((c, i) => (
          <article class:list={['short', spans[i]]} id={`case-${c.id}`} aria-labelledby={`case-${c.id}-title`} data-reveal style={`--d: ${i * 120}`}>
            <p class="short__num num" aria-hidden="true">{pad(start + i + 1)}</p>
            <h3 class="short__title" id={`case-${c.id}-title`}>{c.title}</h3>
            <p class="short__tags eyebrow">
              <span>{c.sphere}</span>
              <span class="short__tag-muted">{c.metaValue}</span>
            </p>
            {c.figure && (
              <p class="short__figure">
                <span class="short__figure-value">{c.figure.value}</span>
                <span class="short__figure-caption">{c.figure.caption}</span>
              </p>
            )}
            {c.body.map((p) => <p class="short__text">{p}</p>)}
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .also__title {
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
    font-size: var(--fs-display);
  }

  .also__grid {
    row-gap: 4rem;
    margin-top: clamp(3.5rem, 7vw, 6rem);
    align-items: start;
  }

  .short {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .span-4 {
    grid-column: span 4;
  }

  .span-5 {
    grid-column: span 5;
  }

  .span-3 {
    grid-column: span 3;
  }

  .short__num {
    font-size: clamp(2.5rem, 1.8rem + 2vw, 3.75rem);
    font-weight: 700;
    line-height: 0.85;
    letter-spacing: -0.05em;
    color: var(--c-accent);
  }

  .short__title {
    font-size: clamp(1.25rem, 1.05rem + 0.6vw, 1.625rem);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .short__tags {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .short__tag-muted {
    color: var(--c-slate-2);
  }

  /* Ключевая цифра — на бирюзовой полосе */
  .short__figure {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 0.875rem;
    padding: 1rem 1.125rem;
    background: var(--c-accent-tint);
  }

  .short__figure-value {
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--c-accent-deep);
  }

  .short__figure-caption {
    font-size: var(--fs-small);
    line-height: 1.35;
    color: var(--c-slate);
  }

  .short__text {
    font-size: var(--fs-small);
    line-height: 1.7;
    color: var(--c-slate);
  }

  @media (max-width: 1024px) {
    .span-4,
    .span-5,
    .span-3 {
      grid-column: span 6;
    }

    .span-3 {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 640px) {
    .span-4,
    .span-5,
    .span-3 {
      grid-column: 1 / -1;
    }
  }
</style>
