---
import SectionTag from './SectionTag.astro';
import { about } from '../data/content';

const [intro, ...rest] = about.paragraphs;

// Крупный editorial-заголовок — фраза из первого абзаца, без изменений
const claim = intro.slice(intro.indexOf('Мы закрываем'));
const claimHl = claim.indexOf('что до нас');

// Первая фраза каждого абзаца — полужирным (сам текст не меняется)
const points = rest.map((p) => {
  const i = p.indexOf('. ');
  return { strong: p.slice(0, i + 1), text: p.slice(i + 2) };
});
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="container">
    <SectionTag num="02" label="О нас" aside="Институт кадровых решений" />

    <p class="about__claim" data-reveal aria-hidden="true">
      {claim.slice(0, claimHl)}<span class="hl">{claim.slice(claimHl)}</span>
    </p>

    <div class="about__intro grid">
      <h2 class="about__title h3" id="about-title" data-reveal>{about.title}</h2>
      <p class="about__lead lead" data-reveal style="--d: 100">{intro}</p>
    </div>

    <ol class="about__points grid">
      {
        points.map((p, i) => (
          <li class="about__point" data-reveal style={`--d: ${i * 100}`}>
            <span class="about__point-num eyebrow num"><span class="node" aria-hidden="true" />{String(i + 1).padStart(2, '0')}</span>
            {i === 0 && (
              <p class="about__fact" aria-hidden="true">
                <span class="about__fact-value">0</span>
                <span class="about__fact-caption eyebrow">замен по гарантии за 1 год</span>
              </p>
            )}
            <p class="about__point-text">
              <strong>{p.strong}</strong> {p.text}
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .about__claim {
    max-width: 15ch;
    margin-top: clamp(3rem, 7vw, 6rem);
    font-size: var(--fs-display);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .about__intro {
    row-gap: 1.5rem;
    margin-top: clamp(3.5rem, 7vw, 6rem);
  }

  .about__title {
    grid-column: 1 / span 4;
    max-width: 14ch;
  }

  .about__lead {
    grid-column: 6 / -1;
    max-width: 38ch;
    color: var(--c-slate);
  }

  .about__points {
    row-gap: 3rem;
    margin-top: clamp(4rem, 8vw, 7rem);
  }

  .about__point {
    grid-column: span 4;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .about__point-num {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--c-accent);
  }

  /* Цифра на цветовом поле вместо рамки */
  .about__fact {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem 1.5rem 1.25rem;
    background: var(--c-mist);
  }

  .about__fact-value {
    font-size: clamp(4rem, 2.5rem + 4vw, 7rem);
    font-weight: 700;
    line-height: 0.78;
    letter-spacing: -0.06em;
    color: var(--c-navy);
  }

  .about__fact-caption {
    max-width: 14ch;
    text-align: right;
    color: var(--c-slate);
  }

  .about__point-text {
    max-width: 36ch;
    font-size: var(--fs-small);
    line-height: 1.65;
    color: var(--c-slate);
  }

  .about__point-text strong {
    display: block;
    margin-bottom: 0.625rem;
    font-size: var(--fs-h4);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--c-ink);
  }

  @media (max-width: 960px) {
    .about__title,
    .about__lead,
    .about__point {
      grid-column: 1 / -1;
    }
  }
</style>
