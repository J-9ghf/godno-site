---
import SectionTag from './SectionTag.astro';
import Icon from './Icon.astro';
import { about } from '../data/content';

const panelId = 'about-more';
const btnId = 'about-more-btn';
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="container">
    <SectionTag num="02" label="О нас" aside="Институт кадровых решений" />

    <!-- Компьютер: заголовок, тезисы в три колонки и кнопка слева, фото с подписью справа.
         Планшет и телефон: заголовок, компактное фото с подписью сбоку, тезисы друг под другом -->
    <div class="about__layout">
    <h2 class="about__title h2" id="about-title" data-reveal>{about.title}</h2>

    <figure class="about__founder" data-reveal>
      <img
        class="about__founder-photo"
        src={about.founder.photo}
        alt={about.founder.alt}
        width="640"
        height="800"
        loading="lazy"
        decoding="async"
      />
      <figcaption class="about__founder-cap">
        <span class="about__founder-name">{about.founder.name}</span>
        <span class="about__founder-role">{about.founder.role}</span>
      </figcaption>
    </figure>

    <!-- Три тезиса; факт про гарантию — строкой в первом -->
    <ol class="about__cards">
      {
        about.theses.map((t, i) => (
          <li class="about__card" data-reveal style={`--d: ${i * 90}`}>
            <span class="about__card-num eyebrow num">
              <span class="node" aria-hidden="true" />
              {String(i + 1).padStart(2, '0')}
            </span>
            <p class="about__thesis">{t}</p>
            {i === 0 && (
              <p class="about__guarantee">
                <span class="node" aria-hidden="true" />
                {about.guarantee}
              </p>
            )}
          </li>
        ))
      }
    </ol>

    <!-- Полный утверждённый текст блока — по кнопке -->
    <div class="about__more" data-accordion>
      <div class="about__more-panel" id={panelId} role="region" aria-labelledby={btnId} data-accordion-panel>
        <div class="about__more-inner">
          {about.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <button class="about__toggle" id={btnId} type="button" aria-expanded="false" aria-controls={panelId} data-accordion-trigger>
        <span class="about__toggle-open">Читать полностью</span>
        <span class="about__toggle-close">Свернуть</span>
        <Icon name="arrow-down" class="about__toggle-icon" />
      </button>
    </div>
    </div>
  </div>
</section>

<style>
  .about__layout {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-areas:
      'ti ti ti ti ti ti ti ti ph ph ph ph'
      'ca ca ca ca ca ca ca ca ph ph ph ph'
      'mo mo mo mo mo mo mo mo ph ph ph ph';
    grid-template-rows: auto auto 1fr;
    align-items: start;
    column-gap: var(--gutter);
    row-gap: clamp(2rem, 4vw, 3rem);
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .about__title {
    grid-area: ti;
    max-width: 14ch;
    font-size: var(--fs-display);
  }

  /* Фото руководителя с подписью */
  .about__founder {
    grid-area: ph;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
  }

  .about__founder-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: var(--c-mist);
  }

  .about__founder-name {
    display: block;
    font-size: var(--fs-h4);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--c-ink);
  }

  .about__founder-role {
    display: block;
    margin-top: 0.25rem;
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--c-slate);
  }

  /* Тезисы: три карточки в ряд */
  .about__cards {
    grid-area: ca;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .about__card {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding: clamp(1.25rem, 2vw, 1.75rem);
    background: var(--c-white);
  }

  .about__card-num {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--c-accent);
  }

  .about__thesis {
    font-size: var(--fs-h4);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--c-ink);
    text-wrap: balance;
  }

  /* Факт про гарантию внутри первого тезиса */
  .about__guarantee {
    display: grid;
    grid-template-columns: 8px minmax(0, 1fr);
    align-items: baseline;
    gap: 0.625rem;
    margin-top: -0.5rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(var(--shade) / 0.14);
    font-size: var(--fs-small);
    font-weight: 700;
    line-height: 1.4;
    color: var(--c-accent);
  }

  /* Полный текст — раскрывается */
  .about__more {
    grid-area: mo;
  }

  .about__more-panel {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.55s var(--ease);
  }

  :global(.js) .about__more:not(.is-open) .about__more-panel {
    grid-template-rows: 0fr;
  }

  .about__more-inner {
    min-height: 0;
    overflow: hidden;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--gutter);
  }

  :global(.js) .about__more:not(.is-open) .about__more-inner {
    visibility: hidden;
    transition: visibility 0s 0.55s;
  }

  .about__more-inner p {
    max-width: 58ch;
    padding-bottom: 1.25rem;
    color: var(--c-slate);
  }

  .about__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 0;
    border: 0;
    background: none;
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--c-accent);
    cursor: pointer;
  }

  .about__toggle:hover {
    color: var(--c-accent-deep);
  }

  .about__toggle-close,
  .about__more.is-open .about__toggle-open {
    display: none;
  }

  .about__more.is-open .about__toggle-close {
    display: inline;
  }

  :global(.about__toggle-icon) {
    width: 16px;
    height: 16px;
    transition: transform var(--t-base) var(--ease);
  }

  .about__more.is-open :global(.about__toggle-icon) {
    transform: rotate(180deg);
  }

  /* Без JS кнопка не нужна — текст и так виден */
  .about__toggle {
    visibility: hidden;
  }

  :global(.js) .about__toggle {
    visibility: visible;
  }

  @media (max-width: 1100px) {
    .about__more-inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Планшет и телефон: заголовок, фото с подписью сбоку, тезисы, кнопка */
  @media (max-width: 960px) {
    .about__layout {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'ti' 'ph' 'ca' 'mo';
      grid-template-rows: auto;
    }

    .about__title {
      font-size: var(--fs-h2);
    }

    .about__founder {
      flex-direction: row;
      align-items: flex-end;
      gap: 1.25rem;
    }

    .about__founder-photo {
      flex: none;
      width: 13rem;
    }
  }

  /* Телефон: компактное фото (кадр 4:5 целиком), тезисы в одну колонку */
  @media (max-width: 640px) {
    .about__founder {
      align-items: center;
      gap: 1rem;
    }

    .about__founder-photo {
      width: clamp(7rem, 34vw, 9rem);
    }

    .about__cards {
      grid-template-columns: minmax(0, 1fr);
    }

    .about__card {
      gap: 1rem;
    }
  }
</style>
