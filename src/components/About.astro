---
import SectionTag from './SectionTag.astro';
import Icon from './Icon.astro';
import { about } from '../data/content';

const panelId = 'about-more';
const btnId = 'about-more-btn';
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="container">
    <SectionTag num="02" label="О нас" aside="Институт кадровых решений" />

    <!-- Компьютер: фото с подписью слева, текст блока справа. Планшет и телефон: всё друг под другом -->
    <div class="about__layout">
    <h2 class="about__title h2" id="about-title" data-reveal>{about.title}</h2>

    <figure class="about__founder" data-reveal>
      <img
        class="about__founder-photo"
        src={about.founder.photo}
        alt={about.founder.alt}
        width="640"
        height="800"
        loading="lazy"
        decoding="async"
      />
      <figcaption class="about__founder-cap">
        <span class="about__founder-name">{about.founder.name}</span>
        <span class="about__founder-role">{about.founder.role}</span>
      </figcaption>
    </figure>

    <!-- Три тезиса и ключевой факт -->
    <ul class="about__cards">
      {
        about.theses.map((t, i) => (
          <li class="about__card" data-reveal style={`--d: ${i * 90}`}>
            <span class="about__card-num eyebrow num">
              <span class="node" aria-hidden="true" />
              {String(i + 1).padStart(2, '0')}
            </span>
            <p class="about__thesis">{t}</p>
          </li>
        ))
      }
      <li class="about__fact" data-reveal style="--d: 270">
        <span class="about__fact-value num">0</span>
        <span class="about__fact-caption eyebrow">замен по гарантии за 1 год</span>
      </li>
    </ul>

    <!-- Полный утверждённый текст блока — по кнопке -->
    <div class="about__more" data-accordion>
      <div class="about__more-panel" id={panelId} role="region" aria-labelledby={btnId} data-accordion-panel>
        <div class="about__more-inner">
          {about.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <button class="about__toggle" id={btnId} type="button" aria-expanded="false" aria-controls={panelId} data-accordion-trigger>
        <span class="about__toggle-open">Читать полностью</span>
        <span class="about__toggle-close">Свернуть</span>
        <Icon name="arrow-down" class="about__toggle-icon" />
      </button>
    </div>
    </div>
  </div>
</section>

<style>
  .about__layout {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-areas:
      'ph ph ph ph ti ti ti ti ti ti ti ti'
      'ph ph ph ph ca ca ca ca ca ca ca ca'
      'ph ph ph ph mo mo mo mo mo mo mo mo';
    grid-template-rows: auto auto 1fr;
    column-gap: var(--gutter);
    row-gap: clamp(2rem, 4vw, 3rem);
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .about__title {
    grid-area: ti;
    max-width: 16ch;
  }

  /* Фото руководителя с подписью */
  .about__founder {
    grid-area: ph;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin: 0;
  }

  .about__founder-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: var(--c-mist);
  }

  .about__founder-name {
    display: block;
    font-size: var(--fs-h4);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--c-ink);
  }

  .about__founder-role {
    display: block;
    margin-top: 0.25rem;
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--c-slate);
  }

  /* Карточки: 3 тезиса + факт, сетка 2×2 */
  .about__cards {
    grid-area: ca;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gutter);
  }

  .about__card,
  .about__fact {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    min-height: 12rem;
    padding: clamp(1.5rem, 2vw, 2rem);
  }

  .about__card {
    background: var(--c-white);
  }

  .about__card-num {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--c-accent);
  }

  .about__thesis {
    margin-top: auto;
    max-width: 18ch;
    font-size: var(--fs-h4);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--c-ink);
    text-wrap: balance;
  }

  /* Цифра на цветовом поле */
  .about__fact {
    justify-content: space-between;
    background: var(--c-mist);
  }

  .about__fact-value {
    font-size: clamp(4.5rem, 3rem + 4vw, 7.5rem);
    font-weight: 700;
    line-height: 0.78;
    letter-spacing: -0.06em;
    color: var(--c-navy);
  }

  .about__fact-caption {
    max-width: 16ch;
    color: var(--c-slate);
  }

  /* Полный текст — раскрывается */
  .about__more {
    grid-area: mo;
  }

  .about__more-panel {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.55s var(--ease);
  }

  :global(.js) .about__more:not(.is-open) .about__more-panel {
    grid-template-rows: 0fr;
  }

  .about__more-inner {
    min-height: 0;
    overflow: hidden;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--gutter);
  }

  :global(.js) .about__more:not(.is-open) .about__more-inner {
    visibility: hidden;
    transition: visibility 0s 0.55s;
  }

  .about__more-inner p {
    max-width: 58ch;
    padding-bottom: 1.25rem;
    color: var(--c-slate);
  }

  .about__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 0;
    border: 0;
    background: none;
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--c-accent);
    cursor: pointer;
  }

  .about__toggle:hover {
    color: var(--c-accent-deep);
  }

  .about__toggle-close,
  .about__more.is-open .about__toggle-open {
    display: none;
  }

  .about__more.is-open .about__toggle-close {
    display: inline;
  }

  :global(.about__toggle-icon) {
    width: 16px;
    height: 16px;
    transition: transform var(--t-base) var(--ease);
  }

  .about__more.is-open :global(.about__toggle-icon) {
    transform: rotate(180deg);
  }

  /* Без JS кнопка не нужна — текст и так виден */
  .about__toggle {
    visibility: hidden;
  }

  :global(.js) .about__toggle {
    visibility: visible;
  }

  @media (max-width: 1100px) {
    .about__more-inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Планшет и телефон: заголовок, фото с подписью, карточки, кнопка */
  @media (max-width: 960px) {
    .about__layout {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'ti' 'ph' 'ca' 'mo';
      grid-template-rows: auto;
    }

    /* На планшете фото на всю ширину, кадр 4:3 — лицо целиком */
    .about__founder-photo {
      aspect-ratio: 4 / 3;
      object-position: 50% 22%;
    }
  }

  @media (max-width: 640px) {
    /* Телефон: компактное фото (кадр 4:5 целиком) и подпись справа от него */
    .about__founder {
      flex-direction: row;
      align-items: center;
      gap: 1rem;
    }

    .about__founder-photo {
      flex: none;
      width: clamp(7rem, 34vw, 9rem);
      aspect-ratio: 4 / 5;
      object-position: 50% 50%;
    }

    .about__cards {
      grid-template-columns: minmax(0, 1fr);
    }

    .about__card,
    .about__fact {
      min-height: 0;
      gap: 1.25rem;
    }

    /* На телефоне факт — первым */
    .about__fact {
      order: -1;
      flex-direction: row;
      align-items: flex-end;
    }

    .about__fact-caption {
      text-align: right;
    }
  }
</style>
