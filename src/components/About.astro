---
import SectionTag from './SectionTag.astro';
import Icon from './Icon.astro';
import { about } from '../data/content';

const panelId = 'about-more';
const btnId = 'about-more-btn';
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="container">
    <SectionTag num="02" label="О нас" aside="Институт кадровых решений" />

    <!-- Компьютер: слева тёмная колонка с цифрами рынка, справа заголовок, цитата руководителя, тезисы и кнопка.
         Планшет и телефон: заголовок, цитата, цифры, тезисы -->
    <div class="about__layout">
    <div class="about__market" data-reveal>
      <p class="about__market-kicker eyebrow">{about.market.kicker}</p>
      <ul class="about__stats">
        {
          about.market.items.map((m) => (
            <li class="about__stat">
              <span class="about__stat-val num">
                {/* Невидимый итоговый текст держит ширину числа — знак и подпись не прыгают во время счёта */}
                <span class="about__stat-size" aria-hidden="true">{m.text}</span>
                <span class="about__stat-live" aria-hidden="true">
                  {m.prefix}<span data-count={m.value} data-decimals={m.decimals}>{m.text.replace(m.prefix, '').replace(m.suffix, '')}</span>{m.suffix}
                </span>
                <span class="visually-hidden">{m.text}</span>
              </span>
              <span class="about__stat-cap">{m.caption}</span>
              <span class="about__stat-src">{m.source}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <h2 class="about__title h2" id="about-title" data-reveal>{about.title}</h2>

    <figure class="about__founder" data-reveal>
      <img
        class="about__founder-photo"
        src={about.founder.photo}
        alt={about.founder.alt}
        width="640"
        height="800"
        loading="lazy"
        decoding="async"
      />
      <figcaption class="about__founder-cap">
        <blockquote class="about__quote">«{about.quote}»</blockquote>
        <span class="about__founder-name">{about.founder.name}</span>
        <span class="about__founder-role">{about.founder.role}</span>
      </figcaption>
    </figure>

    <!-- Три тезиса; факт про гарантию — строкой в первом -->
    <ol class="about__theses">
      {
        about.theses.map((t, i) => (
          <li class="about__thesis-item">
            <span class="about__thesis-num eyebrow num">
              <span class="node" aria-hidden="true" />
              {String(i + 1).padStart(2, '0')}
            </span>
            <div>
              <p class="about__thesis">{t}</p>
              {i === 0 && (
                <p class="about__guarantee">
                  <span class="node" aria-hidden="true" />
                  {about.guarantee}
                </p>
              )}
            </div>
          </li>
        ))
      }
    </ol>

    <!-- Полный утверждённый текст блока — по кнопке -->
    <div class="about__more" data-accordion>
      <div class="about__more-panel" id={panelId} role="region" aria-labelledby={btnId} data-accordion-panel>
        <div class="about__more-inner">
          {about.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>
      <button class="about__toggle" id={btnId} type="button" aria-expanded="false" aria-controls={panelId} data-accordion-trigger>
        <span class="about__toggle-open">Читать полностью</span>
        <span class="about__toggle-close">Свернуть</span>
        <Icon name="arrow-down" class="about__toggle-icon" />
      </button>
    </div>
    </div>
  </div>
</section>

<style>
  .about__layout {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-areas:
      'ma ma ma ma ma ti ti ti ti ti ti ti'
      'ma ma ma ma ma fo fo fo fo fo fo fo'
      'ma ma ma ma ma li li li li li li li'
      'ma ma ma ma ma mo mo mo mo mo mo mo';
    grid-template-rows: auto auto auto 1fr;
    align-items: start;
    column-gap: var(--gutter);
    row-gap: clamp(2rem, 4vw, 3rem);
    margin-top: clamp(3rem, 6vw, 5rem);
  }

  .about__title {
    grid-area: ti;
    max-width: 16ch;
  }

  /* Цифры рынка труда */
  .about__market {
    grid-area: ma;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: clamp(1.75rem, 3vw, 2.75rem);
    background: var(--c-navy);
    color: var(--c-white);
  }

  .about__market-kicker {
    color: var(--c-accent-bright);
  }

  .about__stats {
    display: flex;
    flex: 1;
    flex-direction: column;
    justify-content: space-between;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .about__stat {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.16);
  }

  .about__stat-val {
    display: inline-grid;
    justify-self: start;
    align-self: flex-start;
    font-size: clamp(2.5rem, 1.6rem + 2.6vw, 4rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .about__stat-size,
  .about__stat-live {
    grid-area: 1 / 1;
    white-space: nowrap;
  }

  .about__stat-size {
    visibility: hidden;
  }

  .about__stat-cap {
    font-size: var(--fs-small);
    color: rgb(255 255 255 / 0.8);
  }

  .about__stat-src {
    font-size: var(--fs-meta);
    color: rgb(255 255 255 / 0.55);
  }

  /* Руководитель: маленькое фото и цитата */
  .about__founder {
    grid-area: fo;
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: 1.25rem;
    align-items: start;
    margin: 0;
  }

  .about__founder-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: var(--c-mist);
  }

  .about__founder-cap {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .about__quote {
    margin: 0 0 0.75rem;
    font-size: var(--fs-lead);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--c-ink);
  }

  .about__founder-name {
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--c-ink);
  }

  .about__founder-role {
    font-size: var(--fs-meta);
    color: var(--c-slate);
  }

  /* Тезисы списком с линиями */
  .about__theses {
    grid-area: li;
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid rgb(var(--shade) / 0.14);
  }

  .about__thesis-item {
    display: grid;
    grid-template-columns: 4rem minmax(0, 1fr);
    align-items: baseline;
    padding: 1.125rem 0;
    border-top: 1px solid rgb(var(--shade) / 0.14);
  }

  .about__thesis-num {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--c-accent);
  }

  .about__thesis {
    font-size: var(--fs-h4);
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: -0.015em;
    color: var(--c-ink);
  }

  .about__guarantee {
    display: grid;
    grid-template-columns: 8px minmax(0, 1fr);
    align-items: baseline;
    gap: 0.625rem;
    margin-top: 0.5rem;
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--c-accent);
  }

  /* Полный текст — раскрывается */
  .about__more {
    grid-area: mo;
  }

  .about__more-panel {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.55s var(--ease);
  }

  :global(.js) .about__more:not(.is-open) .about__more-panel {
    grid-template-rows: 0fr;
  }

  .about__more-inner {
    min-height: 0;
    overflow: hidden;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--gutter);
  }

  :global(.js) .about__more:not(.is-open) .about__more-inner {
    visibility: hidden;
    transition: visibility 0s 0.55s;
  }

  .about__more-inner p {
    max-width: 58ch;
    padding-bottom: 1.25rem;
    color: var(--c-slate);
  }

  .about__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.625rem 0;
    border: 0;
    background: none;
    font-size: var(--fs-small);
    font-weight: 700;
    color: var(--c-accent);
    cursor: pointer;
  }

  .about__toggle:hover {
    color: var(--c-accent-deep);
  }

  .about__toggle-close,
  .about__more.is-open .about__toggle-open {
    display: none;
  }

  .about__more.is-open .about__toggle-close {
    display: inline;
  }

  :global(.about__toggle-icon) {
    width: 16px;
    height: 16px;
    transition: transform var(--t-base) var(--ease);
  }

  .about__more.is-open :global(.about__toggle-icon) {
    transform: rotate(180deg);
  }

  /* Без JS кнопка не нужна — текст и так виден */
  .about__toggle {
    visibility: hidden;
  }

  :global(.js) .about__toggle {
    visibility: visible;
  }

  @media (max-width: 1100px) {
    .about__more-inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Планшет и телефон: заголовок, цитата, цифры, тезисы, кнопка */
  @media (max-width: 960px) {
    .about__layout {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'ti' 'fo' 'ma' 'li' 'mo';
      grid-template-rows: auto;
    }
  }

  @media (max-width: 640px) {
    .about__founder {
      grid-template-columns: 5.5rem minmax(0, 1fr);
      gap: 1rem;
    }

    .about__quote {
      font-size: var(--fs-body);
    }

    .about__thesis-item {
      grid-template-columns: 3.25rem minmax(0, 1fr);
    }
  }
</style>
