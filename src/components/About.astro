---
import SectionTag from './SectionTag.astro';
import Icon from './Icon.astro';
import { about } from '../data/content';

const [intro, ...rest] = about.paragraphs;

// Первая фраза каждого абзаца — полужирным (сам текст не меняется)
const points = rest.map((p) => {
  const i = p.indexOf('. ');
  return { strong: p.slice(0, i + 1), text: p.slice(i + 2) };
});

const splitAt = about.title.indexOf('уже');
---

<section class="section about" id="about" aria-labelledby="about-title">
  <div class="container">
    <div class="about__head grid">
      <div class="about__title-wrap">
        <SectionTag num="02" label="О нас" />
        <h2 class="h2 about__title" id="about-title" data-reveal>
          {about.title.slice(0, splitAt)}<span class="hl">{about.title.slice(splitAt)}</span>
        </h2>
      </div>
      <p class="about__intro lead" data-reveal style="--d: 120">{intro}</p>
    </div>

    <ul class="about__points">
      {
        points.map((p, i) => (
          <li class="about__point" data-reveal style={`--d: ${i * 100}`}>
            <span class="check">
              <Icon name="check" />
            </span>
            <p>
              <strong>{p.strong}</strong> {p.text}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .about__head {
    align-items: end;
    row-gap: 2rem;
  }

  .about__title-wrap {
    grid-column: 1 / span 7;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.75rem;
  }

  .about__title {
    max-width: 16ch;
  }

  .about__intro {
    grid-column: 9 / -1;
    color: var(--c-ink-2);
  }

  .about__points {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(3rem, 6vw, 5rem);
    padding: clamp(1.75rem, 3vw, 2.75rem) 0;
    border-radius: var(--r-xl);
    background: var(--c-soft);
  }

  .about__point {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-inline: clamp(1.5rem, 2.8vw, 2.75rem);
    font-size: var(--fs-small);
    line-height: 1.6;
    color: var(--c-ink-2);
  }

  .about__point + .about__point {
    border-left: 1px solid var(--c-line-strong);
  }

  .about__point strong {
    display: block;
    margin-bottom: 0.5rem;
    font-size: var(--fs-h4);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.015em;
    color: var(--c-black);
  }

  @media (max-width: 960px) {
    .about__title-wrap,
    .about__intro {
      grid-column: 1 / -1;
    }

    .about__intro {
      max-width: 40ch;
    }

    .about__points {
      grid-template-columns: 1fr;
      padding: 0.5rem 0;
    }

    .about__point {
      flex-direction: row;
      padding-block: 1.75rem;
    }

    .about__point + .about__point {
      border-left: 0;
      border-top: 1px solid var(--c-line-strong);
    }
  }

  @media (max-width: 640px) {
    .about__points {
      border-radius: var(--r-lg);
    }

    .about__point {
      flex-direction: column;
      gap: 1rem;
      padding-inline: 1.25rem;
    }
  }
</style>
