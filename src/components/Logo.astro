---
/**
 * ЛОГОТИП — ВРЕМЕННАЯ ЗАГЛУШКА.
 * Оригинальный файл логотипа не был получен. Чтобы подключить его:
 *   1. положите файл в public/logo.svg (перекрашенный в --c-blue / --c-black);
 *   2. замените содержимое <span class="logo__slot"> на
 *      <img src="/logo.svg" alt="Институт кадровых решений" width="…" height="…" />
 * Все места использования (header, меню, footer, юридические страницы) обновятся сами.
 */
interface Props {
  tone?: 'dark' | 'light';
}
const { tone = 'dark' } = Astro.props;
---

<span class:list={['logo', `logo--${tone}`]}>
  <span class="logo__slot">
    <span class="logo__line">Институт</span>
    <span class="logo__line">кадровых решений</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    /* clear space: минимум высота строчной буквы со всех сторон */
    padding: 0.25rem 0;
  }

  .logo__slot {
    display: flex;
    flex-direction: column;
    font-size: 0.9375rem;
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .logo--light {
    color: var(--c-white);
  }
</style>
