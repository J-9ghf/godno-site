---
/**
 * Логотип Института кадровых решений — из оригинального файла заказчика (public/brand/*.png).
 * Форма и пропорции не изменены: файл используется как альфа-маска, меняется только заливка.
 *   color — бруски справа синие (--c-blue), остальное чёрное (как в цветной версии логотипа);
 *   mono  — весь логотип цветом currentColor.
 * Clear space: не меньше 1/4 высоты логотипа со всех сторон (задаётся в местах использования).
 */
interface Props {
  variant?: 'color' | 'mono';
  class?: string;
}
const { variant = 'color', class: className } = Astro.props;
---

<span class:list={['logo', `logo--${variant}`, className]} role="img" aria-label="Институт кадровых решений">
  {
    variant === 'color' ? (
      <>
        <span class="logo__layer logo__layer--dark" />
        <span class="logo__layer logo__layer--accent" />
      </>
    ) : (
      <span class="logo__layer logo__layer--mono" />
    )
  }
</span>

<style>
  .logo {
    --logo-h: 56px;
    position: relative;
    display: block;
    flex: none;
    height: var(--logo-h);
    /* исходные пропорции файла 638 × 509 */
    aspect-ratio: 638 / 509;
  }

  .logo__layer {
    position: absolute;
    inset: 0;
    -webkit-mask: var(--mask) center / contain no-repeat;
    mask: var(--mask) center / contain no-repeat;
  }

  .logo__layer--dark {
    --mask: url('/brand/logo-dark.png');
    background: var(--c-black);
  }

  .logo__layer--accent {
    --mask: url('/brand/logo-accent.png');
    background: var(--c-blue);
  }

  .logo__layer--mono {
    --mask: url('/brand/logo-mask.png');
    background: currentColor;
  }
</style>
