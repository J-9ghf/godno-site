---
import SectionTag from './SectionTag.astro';
import { principles } from '../data/content';
---

<section class="section section--navy principles" id="approach" aria-labelledby="principles-title">
  <div class="container">
    <SectionTag num="03" label="Подход" aside="4 принципа" />

    <h2 class="h2 principles__title" id="principles-title" data-reveal>
      Чем мы <span class="hl">отличаемся</span>
    </h2>

    <ol class="principles__list">
      {
        principles.map((p, i) => (
          <li class:list={['principle grid', { 'principle--shift': i % 2 === 1 }]} data-reveal>
            <span class="principle__num bignum" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="principle__title h3">{p.title}</h3>
            <p class="principle__text">{p.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .principles__title {
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
    font-size: var(--fs-display);
  }

  .principles__list {
    display: flex;
    flex-direction: column;
    gap: clamp(3rem, 6vw, 5.5rem);
    margin-top: clamp(4rem, 8vw, 7rem);
  }

  .principle {
    align-items: start;
    row-gap: 1.25rem;
  }

  .principle__num {
    grid-column: 1 / span 2;
    color: var(--c-accent-bright);
    transition: transform var(--t-base) var(--ease);
  }

  .principle__title {
    grid-column: 3 / span 5;
    max-width: 16ch;
    padding-top: 0.25rem;
    color: var(--c-white);
  }

  .principle__text {
    grid-column: 8 / span 4;
    max-width: 40ch;
    padding-top: 0.5rem;
    color: var(--c-on-navy-2);
  }

  /* Намеренное смещение чётных строк на одну колонку */
  .principle--shift .principle__title {
    grid-column: 4 / span 5;
  }

  .principle--shift .principle__text {
    grid-column: 9 / span 4;
  }

  .principle:hover .principle__num {
    transform: translateX(6px);
  }

  @media (max-width: 1024px) {
    .principle__title,
    .principle--shift .principle__title,
    .principle__text,
    .principle--shift .principle__text {
      grid-column: 3 / -1;
    }

    .principle__text,
    .principle--shift .principle__text {
      padding-top: 0;
    }
  }

  @media (max-width: 640px) {
    .principle__num,
    .principle__title,
    .principle--shift .principle__title,
    .principle__text,
    .principle--shift .principle__text {
      grid-column: 1 / -1;
    }
  }
</style>
