---
import Logo from './Logo.astro';

/**
 * Идентификация: логотип ИКР целиком — название «Институт кадровых решений» входит в сам файл логотипа.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['brand', className]}>
  <Logo class="brand__logo" />
</span>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
    color: var(--brand-color, var(--c-black));
  }

  .brand :global(.brand__logo) {
    --logo-h: var(--brand-logo-h, 44px);
  }
</style>
