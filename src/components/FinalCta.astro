---
import SectionTag from './SectionTag.astro';
import Icon from './Icon.astro';
import { finalCta } from '../data/content';

const splitAt = finalCta.title.indexOf('и что');
---

<section class="section section--navy cta" id="contact" aria-labelledby="cta-title">
  <div class="container">
    <SectionTag num="10" label="Заявка" />

    <div class="cta__grid grid">
      <div class="cta__text">
        <h2 class="cta__title" id="cta-title" data-reveal>
          {finalCta.title.slice(0, splitAt)}<span class="hl">{finalCta.title.slice(splitAt)}</span>
        </h2>
        <p class="cta__subtitle lead" data-reveal style="--d: 120">{finalCta.subtitle}</p>
      </div>

      <!-- Форма пока работает только как интерфейс: данные никуда не отправляются -->
      <div class="form-wrap" data-reveal style="--d: 180">
        <form class="form" data-form novalidate>
          <label class="field">
            <span class="field__label eyebrow">01 · Как к вам обращаться</span>
            <input class="field__input" type="text" name="name" autocomplete="name" required />
          </label>
          <label class="field">
            <span class="field__label eyebrow">02 · Телефон или Telegram</span>
            <input class="field__input" type="text" name="contact" autocomplete="tel" required />
          </label>
          <label class="field">
            <span class="field__label eyebrow">03 · Кого ищете и что уже пробовали</span>
            <textarea class="field__input field__input--area" name="message" rows="2"></textarea>
          </label>

          <label class="consent">
            <input class="consent__box" type="checkbox" name="consent" required />
            <span class="consent__mark" aria-hidden="true"><Icon name="check" /></span>
            <span class="consent__text">
              Я даю согласие на обработку персональных данных
              и ознакомлен(а) с политикой конфиденциальности
            </span>
          </label>

          <button class="btn form__submit" type="submit">
            {finalCta.button}
            <Icon name="arrow-up-right" class="btn__icon" />
          </button>

          <p class="form__status" role="alert" data-form-status></p>
        </form>

        <div class="form-done" data-form-done hidden tabindex="-1">
          <span class="form-done__mark" aria-hidden="true"><Icon name="check" /></span>
          <p class="form-done__title">Спасибо. Мы свяжемся с вами.</p>
          <button class="form-done__again link-arrow" type="button" data-form-again>Заполнить ещё раз</button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
  }

  .cta__grid {
    row-gap: 3.5rem;
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
  }

  .cta__text {
    grid-column: 1 / span 7;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .cta__title {
    max-width: 14ch;
    font-size: var(--fs-display);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .cta__subtitle {
    max-width: 32ch;
    color: var(--c-ink-2);
  }

  /* Форма без панели: поля — тонкие линии */
  .form-wrap {
    grid-column: 9 / -1;
  }

  .form {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    padding-top: 0.5rem;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .field__label {
    color: var(--c-ink-3);
  }

  .field__input {
    width: 100%;
    padding: 0.625rem 0 0.75rem;
    border: 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.4);
    border-radius: 0;
    color: var(--c-white);
    background: transparent;
    font-size: 1.125rem;
    font-weight: 600;
    transition: border-color var(--t-fast) var(--ease);
  }

  .field__input:focus {
    outline: none;
    border-bottom-color: var(--c-blue);
    box-shadow: 0 1px 0 var(--c-blue);
  }

  .field__input[aria-invalid='true'] {
    border-bottom-color: var(--c-blue);
    box-shadow: 0 1px 0 var(--c-blue);
  }

  .field__input--area {
    min-height: 4.5rem;
    resize: vertical;
  }

  .consent {
    position: relative;
    display: grid;
    grid-template-columns: 20px 1fr;
    gap: 0.75rem;
    font-size: var(--fs-meta);
    line-height: 1.5;
    color: var(--c-ink-2);
    cursor: pointer;
  }

  .consent__box {
    position: absolute;
    opacity: 0;
    width: 20px;
    height: 20px;
    margin: 0;
  }

  .consent__mark {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border: 1px solid rgb(255 255 255 / 0.6);
    border-radius: 2px;
    color: transparent;
    transition:
      background-color var(--t-fast) var(--ease),
      border-color var(--t-fast) var(--ease);
  }

  :global(.consent__mark svg) {
    width: 12px;
    height: 12px;
  }

  .consent__box:checked + .consent__mark {
    border-color: var(--c-blue);
    background: var(--c-blue);
    color: var(--c-white);
  }

  .consent__box:focus-visible + .consent__mark {
    outline: 2px solid var(--c-blue);
    outline-offset: 2px;
  }

  .consent__box[aria-invalid='true'] + .consent__mark {
    border-color: var(--c-blue);
    box-shadow: 0 0 0 3px var(--c-blue-light-2);
  }

  .consent a {
    color: var(--c-black);
    text-underline-offset: 2px;
  }

  .consent a:hover {
    color: var(--c-blue);
  }

  .form__submit {
    --btn-bg: var(--c-accent-bright);
    --btn-fg: var(--c-navy);
    --btn-bg-hover: var(--c-white);
    align-self: flex-start;
    min-width: 15rem;
    justify-content: space-between;
  }

  .form__submit[disabled] {
    opacity: 0.6;
    cursor: progress;
  }

  /* Состояние после отправки */
  .form-done {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.5rem;
    padding-top: 1.75rem;
    padding-left: 0;
    animation: done-in var(--t-slow) var(--ease);
  }

  .form[hidden],
  .form-done[hidden] {
    display: none;
  }

  .form-done:focus {
    outline: none;
  }

  @keyframes done-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  .form-done__mark {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    background: var(--c-accent-bright);
    color: var(--c-navy);
    color: var(--c-white);
  }

  :global(.form-done__mark svg) {
    width: 26px;
    height: 26px;
  }

  .form-done__title {
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .form-done__again {
    padding: 0 0 2px;
    border: 0;
    background-color: transparent;
    font-size: var(--fs-small);
    color: var(--c-blue);
    cursor: pointer;
  }

  .form__status:empty {
    display: none;
  }

  .form__status {
    padding-top: 1rem;
    border-top: 1px solid var(--c-blue);
    font-size: var(--fs-small);
    font-weight: 600;
    color: var(--c-blue-dark);
  }

  @media (max-width: 1024px) {
    .cta__text,
    .form-wrap {
      grid-column: 1 / -1;
    }

    .form-wrap {
      max-width: 36rem;
    }
  }

  @media (max-width: 640px) {
    .form__submit {
      width: 100%;
    }
  }
</style>
