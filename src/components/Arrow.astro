---
interface Props {
  class?: string;
  direction?: 'right' | 'down' | 'up-right';
}
const { class: className, direction = 'right' } = Astro.props;
const paths = {
  right: 'M3 10h13M11 5l5 5-5 5',
  down: 'M10 3v13M5 11l5 5 5-5',
  'up-right': 'M5 15L15 5M7 5h8v8',
};
---

<svg class={className} viewBox="0 0 20 20" fill="none" aria-hidden="true">
  <path d={paths[direction]} stroke="currentColor" stroke-width="1.4" stroke-linecap="square"></path>
</svg>
