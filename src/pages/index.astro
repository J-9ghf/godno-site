---
import Assist from '../layouts/Assist.astro';
import Header from '../ikr/Header.astro';
import Hero from '../ikr/Hero.astro';
import Why from '../ikr/Why.astro';
import Ai from '../ikr/Ai.astro';
import Us from '../ikr/Us.astro';
import About from '../ikr/About.astro';
import Process from '../ikr/Process.astro';
import Cases from '../ikr/Cases.astro';
import Guarantees from '../ikr/Guarantees.astro';
import Faq from '../ikr/Faq.astro';
import FinalCta from '../ikr/FinalCta.astro';
import Footer from '../ikr/Footer.astro';
---

<Assist
  title="ИКР.Ассистенты — ассистент, с которым вы успеваете в разы больше"
  description="Подбираем ассистентов, которые остаются, и налаживаем работу с ними. Первая подборка за 5–7 рабочих дней, 99% приживаемость сотрудников за 1 год. Направление Института кадровых решений."
>
  <Header />
  <main id="main">
    <Hero />
    <Why />
    <Ai />
    <Us />
    <About />
    <Process />
    <Cases />
    <Guarantees />
    <Faq />
    <FinalCta />
  </main>
  <Footer />
</Assist>
