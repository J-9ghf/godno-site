---
import SecTag from './SecTag.astro';
import Words from './Words.astro';
import { about } from '../data/assistants';
---

<section class="section section--paper2 about" id="about" aria-labelledby="about-title">
  <div class="wrap">
    <SecTag n="05" label="О нас" />

    <div class="about__grid">
      <figure class="portrait" data-reveal>
        <div class="portrait__frame" data-parallax-img>
          {about.photo ? (
            <img src={about.photo} alt={about.name} loading="lazy" />
          ) : (
            <div class="portrait__mono" aria-hidden="true">
              <span class="portrait__initials">ЕЯ</span>
              <span class="portrait__line"></span>
              <span class="label">ИКР.Ассистенты</span>
            </div>
          )}
        </div>
        <figcaption class="portrait__cap">
          <span class="t-s">{about.name}</span>
          <span class="label t-muted">{about.role}</span>
        </figcaption>
      </figure>

      <div class="about__story">
        <h2 class="about__quote t-xl" id="about-title" data-words>
          <span class="about__q" aria-hidden="true">«</span><Words text={about.quote} /><span class="about__q" aria-hidden="true">»</span>
        </h2>

        {about.story.length > 0 && (
          <div class="about__text" data-reveal>
            {about.story.map((p) => <p class="t-lead">{p}</p>)}
          </div>
        )}

        <dl class="facts-list" data-stagger>
          {about.facts.map((f, i) => (
            <div class="facts-list__row">
              <dt><span class="label accent">{String(i + 1).padStart(2, '0')}</span>{f.label}</dt>
              {f.value && <dd>{f.value}</dd>}
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    gap: clamp(40px, 6vw, 96px);
  }

  .portrait {
    position: relative;
  }

  .portrait__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--r-l);
    overflow: hidden;
    background: var(--paper-3);
  }

  /* Пока нет фото — монограмма в цветах системы */
  .portrait__mono {
    position: absolute;
    inset: -8% 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 22px;
    background:
      radial-gradient(80% 60% at 30% 25%, rgb(var(--accent-rgb) / 0.16), transparent 70%),
      var(--paper-3);
  }

  .portrait__initials {
    font-size: clamp(6rem, 3rem + 10vw, 13rem);
    font-weight: 600;
    letter-spacing: -0.07em;
    line-height: 0.8;
    color: var(--ink);
  }

  .portrait__line {
    width: 56px;
    height: 3px;
    background: var(--accent);
  }

  .portrait__mono .label {
    color: var(--muted);
  }

  .portrait__frame :global(img) {
    position: absolute;
    inset: -8% 0;
    width: 100%;
    height: 116%;
    object-fit: cover;
  }

  .portrait__cap {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6px 16px;
    padding-top: 16px;
  }

  .about__quote {
    position: relative;
    margin-bottom: clamp(32px, 4vw, 56px);
  }

  .about__q {
    color: var(--accent);
  }

  .about__text {
    display: grid;
    gap: 1em;
    max-width: 46ch;
    margin-bottom: clamp(40px, 5vw, 72px);
  }

  .about__quote + .facts-list {
    margin-top: clamp(8px, 2vw, 24px);
  }

  .facts-list__row {
    display: grid;
    gap: 10px;
    padding-block: 18px;
    border-top: 1px solid var(--line);
    transition: padding 0.5s var(--ease);
  }

  .facts-list__row:hover {
    padding-left: 10px;
  }

  .facts-list dt {
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-size: var(--fs-s);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .facts-list dd {
    padding: 10px 14px;
    place-items: start;
    text-align: left;
    border-radius: 8px;
  }

  /* Телефон/планшет: фото на половину ширины, имя и должность справа */
  @media (max-width: 899px) {
    .portrait {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
      gap: 16px;
    }

    .portrait__cap {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      padding: 0 0 4px;
    }
  }

  @media (min-width: 900px) {
    .about__grid {
      grid-template-columns: 5fr 7fr;
      align-items: start;
    }

    .portrait {
      position: sticky;
      top: calc(var(--header-h) + 24px);
    }

    .facts-list__row:has(dd) {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
  }
</style>
