---
import { contacts, footer, nav } from '../data/assistants';
const year = new Date().getFullYear();
---

<footer class="ftr">
  <div class="wrap">
    <p class="ftr__sign" data-words aria-label={footer.signature}>
      <span aria-hidden="true">
        {footer.signature.split(' ').map((w, i, a) => (
          <Fragment><span class="w"><span>{w}</span></span>{i < a.length - 1 ? ' ' : ''}</Fragment>
        ))}
      </span>
    </p>

    <div class="ftr__grid">
      <div class="ftr__brand">
        <img src="/brand/ikr-logo-sage.png" width="242" height="56" alt="ИКР — Институт кадровых решений" loading="lazy" />
        <p class="ftr__product">{footer.brand}</p>
      </div>

      <nav class="ftr__col" aria-label="Разделы сайта">
        <p class="label t-muted">Разделы</p>
        <ul>
          {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        </ul>
      </nav>

      <div class="ftr__col">
        <p class="label t-muted">Контакты</p>
        <ul>
          <li>Telegram: <a href={contacts.telegramUrl} target="_blank" rel="noopener">{contacts.telegram}</a></li>
          <li>Телефон: <a href={contacts.phoneHref}>{contacts.phone}</a></li>
          <li>Сайт: <a href={contacts.siteUrl} target="_blank" rel="noopener">{contacts.site}</a></li>
        </ul>
      </div>
    </div>

    <div class="ftr__bottom">
      <span>© {year} {footer.brand}</span>
      <a href="/privacy">Политика конфиденциальности</a>
      <a href="#top" class="ftr__up">Наверх ↑</a>
    </div>
  </div>
</footer>

<style>
  .ftr {
    padding-block: clamp(64px, 8vw, 120px) calc(32px + env(safe-area-inset-bottom));
  }

  .ftr__sign {
    font-size: clamp(2.4rem, 0.6rem + 7.2vw, 9rem);
    font-weight: 600;
    letter-spacing: -0.048em;
    line-height: 0.92;
    max-width: 14ch;
    margin-bottom: clamp(56px, 7vw, 112px);
  }

  .ftr__grid {
    display: grid;
    gap: 36px;
    padding-top: 36px;
    border-top: 1px solid var(--line-strong);
  }

  .ftr__brand img {
    height: 44px;
    width: auto;
  }

  .ftr__product {
    margin-top: 14px;
    font-family: var(--f-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ftr__col ul {
    display: grid;
    gap: 6px;
    margin-top: 14px;
  }

  .ftr a {
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
    transition: color 0.3s;
  }

  .ftr a:hover {
    color: var(--accent);
  }

  .ftr__col a {
    text-decoration: none;
  }

  .ftr__bottom {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 28px;
    margin-top: 56px;
    font-size: var(--fs-small);
    color: var(--muted);
  }

  .ftr__up {
    margin-left: auto;
  }

  @media (min-width: 768px) {
    .ftr__grid {
      grid-template-columns: 2fr 1fr 1.4fr;
    }
  }

  @media (max-width: 767px) {
    .ftr {
      padding-bottom: calc(100px + env(safe-area-inset-bottom));
    }
  }
</style>
