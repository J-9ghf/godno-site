---
import Words from '../ikr/Words.astro';
import { about } from '../data/assistants';
---

<section class="ab s-onyx sec" id="about" aria-labelledby="ab-title">
  <div class="frame">
    <p class="coord coord--sig" data-fade>05 / 09 — О нас</p>

    <div class="ab__comp">
      <h2 class="ab__q d" id="ab-title" data-words data-fit-group="1">
        <span class="ab__l ab__l--1"><Words text="Я сама" /></span>
        <span class="ab__l ab__l--2"><Words text="начинала" /></span>
        <span class="ab__l ab__l--3 sig"><Words text="как" /></span>
        <span class="ab__l ab__l--4"><Words text="ассистент." /></span>
      </h2>

      <figure class="ab__photo" data-reveal-img>
        <div class="ab__mask">
          <!-- Заменить на <img src="/media/ekaterina.jpg" alt="Екатерина Яковлева" /> -->
          <div class="ph ab__ph" data-img-inner>
            <span>Фото Екатерины Яковлевой</span>
            <span>вертикальное, от 1200 × 1800</span>
          </div>
        </div>
        <figcaption class="ab__cap">
          <span class="tag">{about.name}</span>
          <span class="tag muted">{about.role}</span>
        </figcaption>
      </figure>
    </div>

    <div class="ab__cols">
      <p class="ab__side vtext tag muted" aria-hidden="true">{about.name} · история</p>
      <div class="ph ab__story" data-fade>{about.storyPlaceholder}</div>
      <ol class="ab__facts" data-fade-group>
        {about.facts.map((f, i) => (
          <li>
            <span class="ab__fn d sig">0{i + 1}</span>
            <span class="ab__fl">{f.label}</span>
            <span class="ph ab__fv">{f.placeholder}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .ab {
    overflow: hidden;
  }

  .ab__comp {
    position: relative;
    margin-top: clamp(32px, 4vw, 56px);
  }

  .ab__q {
    display: flex;
    flex-direction: column;
    font-size: clamp(3rem, 0.6rem + 11.6vw, 15rem);
    line-height: 0.84;
    letter-spacing: -0.06em;
  }

  .ab__l {
    display: block;
    white-space: nowrap;
  }

  .ab__photo {
    position: relative;
    margin: 32px 0 0;
  }

  .ab__mask {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--onyx-2);
    clip-path: inset(var(--clip, 0%) 0 0 0);
  }

  .ab__ph {
    position: absolute;
    inset: -10% 0;
    border: 0;
    background: repeating-linear-gradient(-45deg, transparent 0 12px, rgb(231 227 216 / 0.05) 12px 13px);
  }

  .ab__mask :global(img) {
    position: absolute;
    inset: -10% 0;
    width: 100%;
    height: 120%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
  }

  .ab__cap {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding-top: 12px;
  }

  .ab__cols {
    display: grid;
    gap: 40px;
    margin-top: clamp(64px, 8vw, 140px);
  }

  .ab__side {
    display: none;
  }

  .ab__story {
    min-height: 280px;
  }

  .ab__facts li {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 6px 14px;
    padding-block: 16px;
    border-top: 1px solid var(--line);
  }

  .ab__fn {
    font-size: 1.05rem;
    line-height: 1.2;
  }

  .ab__fl {
    font-family: var(--f-display);
    font-size: 1rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .ab__fv {
    grid-column: 2;
    padding: 8px 10px;
    place-content: start;
    text-align: left;
    font-size: 0.6rem;
  }

  @media (min-width: 900px) {
    .ab__l--2 {
      padding-left: 12vw;
    }

    .ab__l--3 {
      padding-left: 4vw;
    }

    .ab__l--4 {
      padding-left: 0;
    }

    /* Фото врезается в типографику: стоит в «пустоте» справа, текст идёт поверх */
    .ab__comp {
      display: grid;
      grid-template-columns: 1fr min(28vw, 420px);
    }

    .ab__q {
      grid-column: 1 / -1;
      grid-row: 1;
      position: relative;
      z-index: 2;
      pointer-events: none;
      mix-blend-mode: difference;
    }

    .ab__photo {
      grid-column: 2;
      grid-row: 1;
      align-self: start;
      margin: 18% 0 0;
    }

    .ab__mask {
      aspect-ratio: 3 / 4.2;
    }

    .ab__cols {
      grid-template-columns: 40px 6fr 5fr;
      gap: clamp(32px, 4vw, 72px);
      align-items: start;
    }

    .ab__side {
      display: block;
    }
  }
</style>
