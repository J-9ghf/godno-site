---
{n === 'tg' ? (
  <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M21.4 4.3 2.9 11.4c-1.3.5-1.2 1.2-.2 1.5l4.7 1.5 1.8 5.6c.2.6.4.8.9.8.4 0 .6-.2.9-.4l2.3-2.2 4.7 3.5c.9.5 1.5.2 1.7-.8l3.1-14.6c.3-1.3-.5-1.8-1.4-1.5Zm-3.3 3.3-8.7 7.9-.4 3.6-1.3-4.3 10.3-7.5c.5-.3.6.1.1.3Z" /></svg>
) : (
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="square" aria-hidden="true">
    {n === 'arrow' && <path d="M3 12h17M14 5l7 7-7 7" />}
    {n === 'ne' && <path d="M6 18L18 6M8 6h10v10" />}
